+#!/usr/bin/env python
+"""Train pix2pix for exactly S_D updates (one D and one G step per batch of B_D) on trainval.
+
+    python train_geocr.py --config <configs/<corpus>.sh> --seed 0 --out runs
+
+The model, losses, optimizers and the 'linear' LR policy are the repository's own; the epoch
+horizon is derived from S_D (constant LR for the first half of the epochs, linear decay over the
+second half). Writes <out>/<corpus>_pix2pix_seed<N>/latest_net_{G,D}.pth.
+"""
+from __future__ import annotations
+
+import argparse
+import math
+import random
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+import geocr_data as G
+
+
+def parse_cfg(path) -> dict[str, str]:
+    """configs/<corpus>.sh holds flat KEY="value" lines."""
+    cfg = {}
+    for ln in Path(path).read_text().splitlines():
+        ln = ln.strip()
+        if ln and not ln.startswith("#") and "=" in ln:
+            k, v = ln.split("=", 1)
+            cfg[k] = v.strip().strip('"')
+    return cfg
+
+
+def seed_all(seed: int) -> None:
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+
+
+def _worker_init(worker_id: int) -> None:
+    wseed = torch.initial_seed() % (2 ** 32)
+    random.seed(wseed)
+    np.random.seed(wseed)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", default="runs")
+    a = ap.parse_args()
+
+    cfg = parse_cfg(a.config)
+    s_d, b_d = int(cfg["S_D"]), int(cfg["B_D"])
+    seed_all(a.seed)
+    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
+    if device.type == "cuda":
+        torch.cuda.set_device(0)
+
+    from options.train_options import TrainOptions
+    name = f"{cfg['CORPUS']}_pix2pix_seed{a.seed}"
+    sys.argv = ["train_geocr.py", "--dataroot", str(G.CR_EXPORTS), "--name", name,
+                "--checkpoints_dir", a.out, "--model", "pix2pix", "--direction", "AtoB",
+                "--dataset_mode", "geocr", "--corpus", cfg["CORPUS"], "--batch_size", cfg["B_D"],
+                "--lr", cfg["LR"], "--num_threads", cfg["NUM_THREADS"], "--no_html"]
+    opt = TrainOptions().parse()
+    opt.device = device
+
+    from data import find_dataset_using_name
+    ds = find_dataset_using_name("geocr")(opt)
+    steps_per_epoch = len(ds) // b_d
+    e_tot = math.ceil(s_d / steps_per_epoch)
+    opt.n_epochs = e_tot // 2
+    opt.n_epochs_decay = e_tot - opt.n_epochs
+    print(f"{cfg['CORPUS']} seed={a.seed} n_train={len(ds)} steps/epoch={steps_per_epoch} "
+          f"epochs={opt.n_epochs}+{opt.n_epochs_decay} lr={opt.lr}")
+
+    from models import create_model
+    model = create_model(opt)
+    model.setup(opt)
+
+    loader_g = torch.Generator()
+    t0, step, epoch = time.time(), 0, opt.epoch_count
+    while step < s_d:
+        loader_g.manual_seed(a.seed * 1_000_003 + epoch)
+        loader = DataLoader(ds, batch_size=b_d, shuffle=True, drop_last=True,
+                            num_workers=int(opt.num_threads), generator=loader_g,
+                            worker_init_fn=_worker_init)
+        for data in loader:
+            model.set_input(data)
+            model.optimize_parameters()
+            step += 1
+            if step % 200 == 0 or step == s_d:
+                losses = " ".join(f"{k}={v:.4f}" for k, v in model.get_current_losses().items())
+                print(f"[{step}/{s_d}] ep{epoch} {losses} ({time.time() - t0:.0f}s)", flush=True)
+            if step >= s_d:
+                break
+        else:
+            model.update_learning_rate()
+            epoch += 1
+            continue
+        break
+
+    model.save_networks("latest")
+    print(f"{step} updates -> {Path(a.out) / name}/latest_net_G.pth")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
