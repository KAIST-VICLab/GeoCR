+#!/usr/bin/env python
+"""Write test-set predictions for geocr.eval: <out>/preds/<id>.npy (float32 CHW in [0, 1],
+unclipped) and <out>/manifest.json.
+
+    python dump.py --config <configs/<corpus>.sh> --ckpt <dir with latest_net_G.pth> --out <dir>
+
+As in the repository's test.py, the generator stays in train mode (dropout active, batch
+normalisation on the statistics of a batch of one); the dropout noise is seeded per image from
+(seed, id), so the predictions do not depend on the order of the test set.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+import geocr_data as G
+import rescore as RS
+from train_geocr import parse_cfg, seed_all
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--ckpt", required=True, help="directory holding latest_net_G.pth")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seed", type=int, default=0)
+    a = ap.parse_args()
+
+    cfg = parse_cfg(a.config)
+    ccfg = G.corpus_cfg(cfg["CORPUS"])
+    ids = G.read_split(ccfg, "test")
+    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
+    seed_all(a.seed)
+
+    from models import create_model
+    from options.test_options import TestOptions
+    ckpt = Path(a.ckpt).resolve()
+    sys.argv = ["dump.py", "--dataroot", str(G.CR_EXPORTS), "--name", ckpt.name,
+                "--checkpoints_dir", str(ckpt.parent), "--model", "pix2pix",
+                "--direction", "AtoB", "--dataset_mode", "geocr", "--corpus", cfg["CORPUS"],
+                "--epoch", "latest"]
+    opt = TestOptions().parse()
+    opt.device = device
+    opt.num_threads, opt.batch_size, opt.serial_batches, opt.no_flip = 0, 1, True, True
+    model = create_model(opt)
+    model.setup(opt)
+
+    preds = Path(a.out) / "preds"
+    preds.mkdir(parents=True, exist_ok=True)
+    with torch.no_grad():
+        for i, sid in enumerate(ids):
+            cy, _ = G.load_pair(ccfg, "test", sid)
+            A = (cy * 2.0 - 1.0)[None].to(device)
+            torch.manual_seed(G.keyed_seed(a.seed, sid))
+            model.set_input({"A": A, "B": A, "A_paths": [sid], "B_paths": [sid]})
+            model.test()
+            arr = ((model.fake_B[0].float().cpu() + 1.0) / 2.0).numpy().astype(np.float32)
+            np.save(preds / f"{Path(G.sid_flat(sid)).stem}.npy", arr)
+            if i % 100 == 0:
+                print(f"{i}/{len(ids)}", flush=True)
+
+    man = {"corpus": ccfg["corpus"], "split": "test",
+           "split_list_sha256": G.split_sha256(ccfg, "test"), "n_items": len(ids),
+           "resolution": list(ccfg["resolution"]), "crop": "none", "bands": list(ccfg["bands"]),
+           "domain": ccfg["domain"], "processing_level": ccfg["level"],
+           "ckpt_selection": "final", "train_split_sha256": G.split_sha256(ccfg, "trainval"),
+           "method": "pix2pix", "seed": a.seed,
+           "ckpt_sha256": RS.sha256_file(ckpt / "latest_net_G.pth")}
+    missing = [k for k in RS.IDENTITY_KEYS if k not in man]
+    if missing:
+        raise SystemExit(f"manifest lacks {missing}")
+    (Path(a.out) / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"{len(ids)} predictions -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
