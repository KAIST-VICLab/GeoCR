new file mode 100644
index 0000000..9faf78a
--- /dev/null
+++ b/geocr_data.py
@@ -0,0 +1,56 @@
+"""GeoCR data adapter: ids from <dataset root>/splits/<split>.txt, pixels from the 8-bit RGB
+export <CR_EXPORTS>/<corpus>/<split>/{cloudy,clear}/<id>.png, paired by id."""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+
+import rescore as RS
+
+CR_EXPORTS = Path(os.environ.get("CR_EXPORTS", "CR_exports"))
+CORPORA = ("tcloud", "cuhk_cr2", "sen2mtc_new_rgb", "sen12mscr_rgb", "whus2crv_rgb")
+SPLITS_DIR = "splits"
+
+
+def corpus_cfg(name: str) -> dict:
+    if name not in CORPORA:
+        raise SystemExit(f"no pix2pix config for {name!r}; choose from {CORPORA}")
+    return dict(RS.CORPORA[name], corpus=name)
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def read_split(cfg: dict, split: str) -> list[str]:
+    return RS.read_split(Path(cfg["root"]), split, SPLITS_DIR)
+
+
+def split_sha256(cfg: dict, split: str) -> str:
+    return RS.sha256_file(Path(cfg["root"]) / SPLITS_DIR / f"{split}.txt")
+
+
+def load_pair_pil(cfg: dict, split: str, sid: str, export_root=None):
+    root = Path(export_root or CR_EXPORTS) / cfg["corpus"] / split
+    name = Path(sid_flat(sid)).with_suffix(".png").name
+    return (Image.open(root / "cloudy" / name).convert("RGB"),
+            Image.open(root / "clear" / name).convert("RGB"))
+
+
+def load_pair(cfg: dict, split: str, sid: str, export_root=None):
+    """(cloudy, clear) as float32 CHW in [0, 1]."""
+    f = lambda im: torch.from_numpy(  # noqa: E731
+        np.ascontiguousarray(np.asarray(im, dtype=np.uint8).transpose(2, 0, 1))).float() / 255.0
+    cy, cl = load_pair_pil(cfg, split, sid, export_root)
+    return f(cy), f(cl)
+
+
+def keyed_seed(seed: int, sid: str) -> int:
+    """Per-sample seed for the test-time dropout noise: blake2b of (seed, id)."""
+    key = hashlib.blake2b(f"{seed}:{sid}".encode(), digest_size=8).digest()
+    return int.from_bytes(key, "big") % (2 ** 63)
