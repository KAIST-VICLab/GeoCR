+"""--dataset_mode geocr: cloudy (A) -> clear (B) training pairs read by split-list id.
+
+The transform is the repository's aligned recipe (one get_params draw shared by A and B)."""
+import geocr_data as G
+from data.base_dataset import BaseDataset, get_params, get_transform
+
+
+class GeocrDataset(BaseDataset):
+    @staticmethod
+    def modify_commandline_options(parser, is_train):
+        parser.add_argument("--corpus", type=str, required=True)
+        parser.add_argument("--export_root", type=str, default=str(G.CR_EXPORTS))
+        return parser
+
+    def __init__(self, opt):
+        BaseDataset.__init__(self, opt)
+        self.cfg = G.corpus_cfg(opt.corpus)
+        self.ids = G.read_split(self.cfg, "trainval")
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, index):
+        sid = self.ids[index]
+        A_img, B_img = G.load_pair_pil(self.cfg, "trainval", sid, self.opt.export_root)
+        params = get_params(self.opt, A_img.size)
+        A = get_transform(self.opt, params)(A_img)
+        B = get_transform(self.opt, params)(B_img)
+        return {"A": A, "B": B, "A_paths": sid, "B_paths": sid}
