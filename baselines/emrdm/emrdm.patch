+"""Sen2_MTC_New split-list dataset (three cloudy frames) on top of the upstream loader."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+from torch.utils.data import Dataset
+
+from geocr_bench.datasets import read_split, sid_flat
+
+
+def _mtc():
+    from sgm.data.sen2_mtc_new.sen2_mtc_new import Sen2_MTC_New_Multi
+    return Sen2_MTC_New_Multi
+
+
+class Sen2MTCNewSplitDataset(_mtc()):
+
+    def __init__(self, root, split="train", splits_dir="splits", use_ir=True,
+                 mono_temporal=-1, multi_temporal=3, limit: int = 0,
+                 split_file: str | None = None):
+        Dataset.__init__(self)
+        assert multi_temporal in [2, 3], "multi_temporal should be 2 or 3"
+        self.data_root = str(root)
+        self.mode = split
+        self.use_ir = use_ir
+        self.mono_temporal = mono_temporal
+        self.multi_temporal = multi_temporal
+
+        self.sids = read_split(Path(root), split, splits_dir, limit, split_file)
+        self.filepair, self.image_name = [], []
+        for sid in self.sids:
+            tgt = Path(root) / sid
+            stem = tgt.stem
+            cloud = tgt.parent.parent / "cloud"
+            frames = [str(cloud / f"{stem}_{i}.tif") for i in range(3)]
+            self.filepair.append(frames + [str(tgt)])
+            self.image_name.append(Path(sid_flat(sid)).stem)
+
+        self.augment_rotation_param = np.random.randint(0, 4, len(self.filepair))
+        self.augment_flip_param = np.random.randint(0, 3, len(self.filepair))
+        self.index = 0
