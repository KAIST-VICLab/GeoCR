@@ -0,0 +1,279 @@
+"""Prediction writer used by predict_step, and the manifest writer/validator for one dump."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import numpy as np
+
+REPO = Path(__file__).resolve().parent.parent
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", REPO.parent / "GeoCR"))
+BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+
+CODE_PATCHES = [
+    "sgm/data/sentinel/sentinel.py: exact ROI split match; path-cache name and location",
+    "sgm/models/diffusion.py: dump_dir/dump_dtype/dump_channels; image_path_key; "
+    "float dump before scale_01",
+    "sgm/modules/diffusionmodules/k_diffusion/image_transformer.py: natten has_fused_na fallback",
+]
+
+
+def write_pred(engine, batch, samples) -> Path:
+    key = engine.get_input(batch, getattr(engine, "image_path_key", "image_path"))[0]
+    if isinstance(key, (list, tuple)):
+        key = key[0]
+    stem = Path(str(key)).stem
+    if not stem:
+        raise RuntimeError("empty dump key: the loader must set image_path to the sample id")
+    arr = ((samples[0].float() + 1.0) / 2.0).detach().cpu().numpy()
+    want_ch = int(getattr(engine, "dump_channels", 0) or 0)
+    if want_ch and arr.shape[0] < want_ch:
+        pad = np.full((want_ch - arr.shape[0], *arr.shape[1:]), np.nan,
+                      dtype=np.float32)
+        arr = np.concatenate([arr, pad], axis=0)
+    elif want_ch and arr.shape[0] > want_ch:
+        raise RuntimeError(f"{stem}: model emitted {arr.shape[0]} channels but the "
+                           f"corpus declares {want_ch}; refusing to truncate")
+    dtype = getattr(engine, "dump_dtype", "float32")
+    if dtype not in ("float32", "float16"):
+        raise ValueError(f"dump_dtype must be float32 or float16, got {dtype!r}")
+    out = Path(engine.dump_dir) / "preds"
+    out.mkdir(parents=True, exist_ok=True)
+    p = out / f"{stem}.npy"
+    np.save(p, np.ascontiguousarray(arr, dtype=np.dtype(dtype)))
+    return p
+
+
+def _sha256(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def _git_rev() -> str:
+    try:
+        return subprocess.run(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"],
+                              capture_output=True, text=True, check=True).stdout.strip()
+    except Exception:
+        return "unknown"
+
+
+def _rescore():
+    for p in (str(BASELINES), str(GEOCR_ROOT)):
+        if p not in sys.path:
+            sys.path.insert(0, p)
+    import rescore
+    return rescore
+
+
+RUN_FACTS = {
+    "tcloud":      dict(frames_used=1, frame_rule="n/a", sar_used=False),
+    "cuhk_cr1":    dict(frames_used=1, frame_rule="n/a", sar_used=False),
+    "cuhk_cr2":    dict(frames_used=1, frame_rule="n/a", sar_used=False),
+    "whus2crv":    dict(frames_used=1, frame_rule="n/a", sar_used=False),
+    "sen12mscr":   dict(frames_used=1, frame_rule="n/a", sar_used=True),
+    "sen2mtc_new": dict(frames_used=3,
+                        frame_rule="all three cloudy frames (multi_temporal=3, upstream)",
+                        sar_used=False),
+}
+
+DISPLAY8 = ("tcloud", "cuhk_cr1", "cuhk_cr2")
+
+BANDS_PREDICTED = {
+    "sen2mtc_new": ["R", "G", "B"],
+}
+
+
+def build_manifest(args) -> dict:
+    R = _rescore()
+    corpus = R.resolve_corpus(args.corpus)
+    if corpus not in R.CORPORA:
+        raise SystemExit(f"unknown corpus {corpus}; have {list(R.CORPORA)}")
+    cfg = R.CORPORA[corpus]
+    root = Path(args.root) if args.root else cfg["root"]
+    sp = root / args.splits_dir / f"{args.split}.txt"
+    ids = R.read_split(root, args.split, args.splits_dir)
+    facts = RUN_FACTS[corpus]
+
+    native = cfg["resolution"]
+    resample = {"op": "none", "reason": "native resolution"}
+    if corpus in DISPLAY8:
+        sys.path.insert(0, str(BASELINES / "exporters"))
+        from export_display8 import CORPORA as E1
+        native = [E1[corpus]["native"]] * 2
+        if native != cfg["resolution"]:
+            resample = {"op": "PIL.BICUBIC",
+                        "via": "geocr.data.benchmarks._resize_u8",
+                        "where": "exporter" if args.export_root else "loader",
+                        "stage": "pre-inference"}
+
+    bands, bands_note, reconcile = cfg["bands"], None, None
+    predicted = BANDS_PREDICTED.get(corpus)
+    if predicted is not None and len(predicted) < len(bands):
+        bands_note = (f"model predicts {len(predicted)} bands {predicted}; planes "
+                      f"{len(predicted)}..{len(bands) - 1} are NaN")
+        print(f"[emrdm-dump] {corpus}: padding {len(predicted)} -> {len(bands)} "
+              f"channels with NaN.\n  {bands_note}")
+
+    train_sp = root / args.splits_dir / f"{args.train_split}.txt"
+    man = {
+        "corpus": corpus, "split": args.split,
+        "split_list": str(sp), "split_list_sha256": _sha256(sp), "n_items": len(ids),
+        "resolution": cfg["resolution"], "native_resolution": native,
+        "resample": resample, "crop": "none",
+        "bands": bands, "domain": cfg["domain"],
+        "dtype": _measured_dtype(Path(args.dump_dir), args.dump_dtype),
+        "processing_level": cfg["level"],
+        "method": args.method, "method_variant": args.method_variant,
+        "code_rev": _git_rev(), "code_patches": CODE_PATCHES,
+        "ckpt_sha256": _sha256(Path(args.ckpt)) if args.ckpt else None,
+        "ckpt_path": args.ckpt, "ckpt_selection": args.ckpt_selection,
+        "train_split": args.train_split,
+        "train_split_sha256": _sha256(train_sp) if train_sp.is_file() else None,
+        "n_train": len(R.read_split(root, args.train_split, args.splits_dir))
+                   if train_sp.is_file() else None,
+        "splits_dir": args.splits_dir,
+        "exclude_list": args.exclude, "seed": args.seed,
+        "sampler": {"type": args.sampler, "nfe": args.nfe},
+        "frames_used": facts["frames_used"], "frame_rule": facts["frame_rule"],
+        "sar_used": facts["sar_used"],
+        "sar_fill": "none" if facts["sar_used"] else "n/a",
+        "steps_used": args.steps_used, "step_ceiling": args.step_ceiling,
+        "ceiling_hit": (None if args.steps_used is None or args.step_ceiling is None
+                        else args.steps_used >= args.step_ceiling),
+        "epochs_used": args.epochs_used,
+        "dev_evaluations_consumed": args.dev_evals,
+        "dev_slope_last10": args.dev_slope_last10,
+        "batch_global": args.batch_global, "microbatch": args.microbatch,
+        "grad_accum": args.grad_accum, "lr": args.lr,
+        "wall_clock_h": args.wall_clock_h, "gpu": args.gpu,
+        "params_trainable": args.params_trainable,
+        "params_total": args.params_total,
+        "precision": "fp32 (TF32 matmul via --enable_tf32)",
+        "bands_predicted": predicted or bands,
+        "bands_note": bands_note,
+        "scorer_reconciliation_required": reconcile,
+        "notes": args.note or None,
+    }
+    return man, root, ids
+
+
+def _measured_dtype(dump_dir: Path, claimed: str) -> str:
+    files = sorted((dump_dir / "preds").glob("*.npy"))
+    if not files:
+        return claimed
+    seen = {str(np.load(f, mmap_mode="r").dtype) for f in files[:16]}
+    if len(seen) != 1:
+        raise SystemExit(f"mixed pred dtypes {sorted(seen)} in {dump_dir}/preds")
+    got = seen.pop()
+    if got != claimed:
+        print(f"[emrdm-dump] WARNING: --dump-dtype said {claimed} but files are "
+              f"{got}; manifest records {got}")
+    return got
+
+
+def validate(dump_dir: Path, man: dict, ids: list[str]) -> list[str]:
+    R = _rescore()
+    problems = []
+    preds = dump_dir / "preds"
+    if not preds.is_dir():
+        return [f"{preds} does not exist -- did predict_step run with dump_dir set?"]
+    stems = {Path(R.sid_flat(s)).stem for s in ids}
+    have = {p.stem for p in preds.glob("*.npy")}
+    if have != stems:
+        miss, extra = sorted(stems - have)[:5], sorted(have - stems)[:5]
+        problems.append(f"dump key set != split list "
+                        f"(split {len(stems)}, dump {len(have)}); "
+                        f"missing {miss}; unexpected {extra}")
+    nch = len(man["bands"])
+    n_pred = len(man.get("bands_predicted") or man["bands"])
+    res = tuple(man["resolution"])
+    for p in sorted(preds.glob("*.npy")):
+        a = np.load(p)
+        if a.ndim != 3:
+            problems.append(f"{p.name}: expected CHW, got {a.shape}")
+        elif a.shape[0] != nch:
+            problems.append(f"{p.name}: {a.shape[0]} channels, corpus declares {nch}")
+        elif tuple(a.shape[1:]) != res:
+            problems.append(f"{p.name}: {tuple(a.shape[1:])} != resolution {res}")
+        elif a.dtype not in (np.float32, np.float16):
+            problems.append(f"{p.name}: dtype {a.dtype}, contract says float32/float16")
+        elif not np.isfinite(a[:n_pred]).all():
+            problems.append(f"{p.name}: non-finite values in predicted planes")
+        elif n_pred < nch and not np.isnan(a[n_pred:]).all():
+            problems.append(f"{p.name}: pad planes must be all-NaN")
+        if len(problems) > 12:
+            problems.append("... further problems suppressed")
+            break
+    return problems
+
+
+def main() -> int:
+    import argparse
+    ap = argparse.ArgumentParser(
+        description="Write and validate the manifest for one EMRDM dump run.",
+        formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--dump-dir", required=True,
+                    help="the run dir: dumps/<corpus>/<split>/emrdm/<run_id>")
+    ap.add_argument("--corpus", required=True)
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--splits-dir", default="splits")
+    ap.add_argument("--root", default=None, help="override the corpus root")
+    ap.add_argument("--export-root", default=None,
+                    help="set if the loader read the PNG export (recorded in the manifest)")
+    ap.add_argument("--method", default="emrdm")
+    ap.add_argument("--method-variant", default="", help="e.g. configs_geocr/tcloud.yaml")
+    ap.add_argument("--ckpt", default=None)
+    ap.add_argument("--ckpt-selection", default="final")
+    ap.add_argument("--train-split", default="trainval")
+    ap.add_argument("--exclude", default=None)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--sampler", default="ResidualEulerEDMSampler")
+    ap.add_argument("--nfe", type=int, default=4)
+    ap.add_argument("--dump-dtype", default="float32", choices=["float32", "float16"])
+    ap.add_argument("--steps-used", type=int, default=None)
+    ap.add_argument("--step-ceiling", type=int, default=None)
+    ap.add_argument("--epochs-used", type=float, default=None)
+    ap.add_argument("--dev-evals", type=int, default=None)
+    ap.add_argument("--dev-slope-last10", type=float, default=None)
+    ap.add_argument("--batch-global", type=int, default=None)
+    ap.add_argument("--microbatch", type=int, default=None)
+    ap.add_argument("--grad-accum", type=int, default=1)
+    ap.add_argument("--lr", type=float, default=None)
+    ap.add_argument("--wall-clock-h", type=float, default=None)
+    ap.add_argument("--gpu", default="B200x1")
+    ap.add_argument("--params-trainable", type=int, default=None)
+    ap.add_argument("--params-total", type=int, default=None)
+    ap.add_argument("--note", default="")
+    ap.add_argument("--no-validate", action="store_true")
+    args = ap.parse_args()
+
+    man, root, ids = build_manifest(args)
+    dump_dir = Path(args.dump_dir)
+    problems = [] if args.no_validate else validate(dump_dir, man, ids)
+    if problems:
+        print(f"[emrdm-dump] REFUSING to write a manifest for {dump_dir}:")
+        for p in problems:
+            print("  " + p)
+        return 2
+    dump_dir.mkdir(parents=True, exist_ok=True)
+    (dump_dir / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"[emrdm-dump] {dump_dir}/manifest.json")
+    print(f"  corpus={man['corpus']} split={man['split']} n_items={man['n_items']} "
+          f"bands={len(man['bands'])} res={man['resolution']} "
+          f"level={man['processing_level']} dtype={man['dtype']}")
+    print(f"  split_list={man['split_list']}")
+    if not args.no_validate:
+        print(f"  validated: {man['n_items']} preds, key set == split list, "
+              f"shapes/dtype/finiteness OK")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
