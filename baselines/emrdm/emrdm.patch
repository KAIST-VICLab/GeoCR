+"""SEN12MS-CR split-list dataset on top of the upstream loader."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from geocr_bench.datasets import read_split, sid_flat
+
+
+def _sen12():
+    from sgm.data.sentinel.sentinel import SEN12MSCRInterface
+    return SEN12MSCRInterface
+
+
+class SEN12MSCRSplitDataset(_sen12()):
+
+    def __init__(self, root, split="train", splits_dir="splits", region="all",
+                 cloud_masks=None, rescale=True, return_target=True,
+                 limit: int = 0, split_file: str | None = None):
+        self._split_kw = dict(splits_dir=splits_dir, limit=limit, split_file=split_file)
+        super().__init__(root=root, split=split, region=region,
+                         cloud_masks=cloud_masks, rescale=rescale,
+                         return_target=return_target)
+
+    def get_paths(self):
+        sids = read_split(Path(self.root_dir), self.split, **self._split_kw)
+        self.sids = sids
+        self.stems = [Path(sid_flat(s)).stem for s in sids]
+        out = []
+        for sid in sids:
+            out.append({"S2_cloudy": os.path.join(self.root_dir, sid),
+                        "S2": os.path.join(self.root_dir, sid.replace("s2_cloudy", "s2")),
+                        "S1": os.path.join(self.root_dir, sid.replace("s2_cloudy", "s1"))})
+        return out
+
+    def __getitem__(self, pdx):
+        out = super().__getitem__(pdx)
+        out["image_path"] = f"{self.stems[pdx]}.tif"
+        return out
diff --git a/geocr_bench/dump.py b/geocr_bench/dump.py
