@@ -0,0 +1,141 @@
+"""Split-list datasets for EMRDM on T-CLOUD, CUHK-CR1/2 and WHUS2-CRv."""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", Path(__file__).resolve().parents[2] / "GeoCR"))
+BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+for _p in (str(BASELINES / "exporters"), str(GEOCR_ROOT)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+
+def _exporters():
+    try:
+        from _common import geocr_import, sid_flat
+        from export_display8 import CORPORA, CORPUS_ALIASES, clear_id
+        from export_whus2 import fuse13
+    except Exception as exc:
+        raise SystemExit(
+            f"cannot import the exporters from {BASELINES/'exporters'}: {exc}; "
+            "set GEOCR_BASELINES"
+        ) from exc
+    return dict(g=geocr_import(), sid_flat=sid_flat, CORPORA=CORPORA,
+                ALIASES=CORPUS_ALIASES, clear_id=clear_id, fuse13=fuse13)
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def read_split(root: Path, split: str, splits_dir: str = "splits",
+               limit: int = 0, split_file: str | None = None) -> list[str]:
+    p = Path(split_file) if split_file else Path(root) / splits_dir / f"{split}.txt"
+    if not p.is_file():
+        raise SystemExit(f"missing split file {p}")
+    out = [s for s in (ln.split("#", 1)[0].strip() for ln in p.read_text().splitlines()) if s]
+    if not out:
+        raise SystemExit(f"{p} is empty")
+    if limit:
+        out = out[:limit]
+    keys = [sid_flat(s) for s in out]
+    if len(set(keys)) != len(keys):
+        dup = sorted({k for k in keys if keys.count(k) > 1})[:5]
+        raise SystemExit(f"{p}: sid_flat COLLISION on {dup}")
+    return out
+
+
+def _chw_pm1(arr_u8: np.ndarray) -> torch.Tensor:
+    if arr_u8.ndim == 2:
+        arr_u8 = arr_u8[..., None]
+    t = torch.from_numpy(np.ascontiguousarray(arr_u8, dtype=np.float32)).permute(2, 0, 1)
+    return t / 255.0 * 2.0 - 1.0
+
+
+class Display8SplitDataset(Dataset):
+
+    def __init__(self, corpus: str, split: str, root: str | None = None,
+                 splits_dir: str = "splits", resolution: int | None = None,
+                 nir: bool | None = None, export_root: str | None = None,
+                 limit: int = 0, split_file: str | None = None):
+        super().__init__()
+        E = _exporters()
+        self.g, self.clear_id = E["g"], E["clear_id"]
+        corpus = E["ALIASES"].get(corpus, corpus)
+        if corpus not in E["CORPORA"]:
+            raise SystemExit(f"unknown display8 corpus {corpus}; "
+                             f"have {list(E['CORPORA'])}")
+        self.corpus = corpus
+        self.cfg = dict(E["CORPORA"][corpus])
+        self.root = Path(root) if root else self.cfg["root"]
+        self.res = resolution or self.cfg["target_res"]
+        self.nir = self.cfg["nir"] if nir is None else bool(nir)
+        self.export = Path(export_root) / corpus / split if export_root else None
+        if self.export is not None and not self.export.is_dir():
+            raise SystemExit(f"export_root given but {self.export} is not a directory")
+        self.nir_root = self.root.parent / "nir" / self.root.name
+
+        self.sids = read_split(self.root, split, splits_dir, limit, split_file)
+        self.keys = [sid_flat(s) for s in self.sids]
+        self.cids = []
+        for sid in self.sids:
+            cid = self.clear_id(sid, self.cfg, self.root)
+            if cid is None:
+                raise SystemExit(f"{self.root/sid}: no clear pair via "
+                                 f"{self.cfg['clear_sub']}")
+            self.cids.append(cid)
+
+    def __len__(self) -> int:
+        return len(self.sids)
+
+    def _png(self, sub: str, key: str, rel: str, want_nir: bool) -> np.ndarray:
+        if self.export is not None:
+            a = self.g["read_png"](self.export / sub / key)
+        else:
+            a = self.g["read_png"]((self.nir_root if want_nir else self.root) / rel)
+            if want_nir and a.ndim == 3:
+                a = a[..., 0]
+            a = self.g["resize_u8"](a, self.res)
+        return a
+
+    def __getitem__(self, i: int) -> dict:
+        key, sid, cid = self.keys[i], self.sids[i], self.cids[i]
+        x = _chw_pm1(self._png("cloudy", key, sid, False))[:3]
+        t = _chw_pm1(self._png("clear", key, cid, False))[:3]
+        if self.nir:
+            xn = _chw_pm1(self._png("cloudy_nir", key, sid, True))[:1]
+            tn = _chw_pm1(self._png("clear_nir", key, cid, True))[:1]
+            x, t = torch.cat([x, xn], 0), torch.cat([t, tn], 0)
+        return {"cond_image": x, "label": t, "cloudy": x[:3],
+                "image_path": f"{Path(key).stem}.png"}
+
+
+class WHUS2SplitDataset(Dataset):
+
+    def __init__(self, root: str, split: str, splits_dir: str = "splits",
+                 limit: int = 0, split_file: str | None = None):
+        super().__init__()
+        E = _exporters()
+        self.g, self.fuse13 = E["g"], E["fuse13"]
+        self.root = Path(root)
+        self.sids = read_split(self.root, split, splits_dir, limit, split_file)
+        self.keys = [sid_flat(s) for s in self.sids]
+
+    def __len__(self) -> int:
+        return len(self.sids)
+
+    def _band13(self, sid: str, role: str) -> torch.Tensor:
+        a = self.fuse13(self.root, sid, role, self.g).astype(np.float32) / 10000.0
+        return torch.from_numpy(a) * 2.0 - 1.0
+
+    def __getitem__(self, i: int) -> dict:
+        sid, key = self.sids[i], self.keys[i]
+        return {"target": self._band13(sid, "clear"),
+                "S2": self._band13(sid, "cloud"),
+                "image_path": f"{Path(key).stem}.tif"}
