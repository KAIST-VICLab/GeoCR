@@ -0,0 +1,24 @@
+"""Selected by --dataroot geocr:<corpus>; the split is --phase. Returns the dict AlignedDataset returns
+under --label_nc 0 --no_instance, with label = cloudy, image = clear and one shared transform draw."""
+from PIL import Image
+
+from data.base_dataset import BaseDataset, get_params, get_transform
+
+
+class GeoCRAlignedDataset(BaseDataset):
+    def name(self):
+        return 'GeoCRAlignedDataset'
+
+    def initialize(self, opt):
+        from geocr_data import GeoCRPairDataset
+        self.opt = opt
+        self.pairs = GeoCRPairDataset(str(opt.dataroot).split(':')[1], opt.phase)
+
+    def __getitem__(self, index):
+        cloudy_u8, clear_u8, sid = self.pairs.pair_u8(index)
+        A, B = Image.fromarray(cloudy_u8), Image.fromarray(clear_u8)
+        transform = get_transform(self.opt, get_params(self.opt, A.size))
+        return {'label': transform(A), 'inst': 0, 'image': transform(B), 'feat': 0, 'path': sid}
+
+    def __len__(self):
+        return len(self.pairs)
