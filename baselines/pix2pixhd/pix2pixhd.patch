+#!/usr/bin/env python
+"""Write test-set predictions for geocr.eval: <out>/preds/<id>.npy (float32 CHW in [0, 1],
+unclipped) and <out>/manifest.json.
+
+    python dump.py --corpus <corpus> --ckpt <dir with final_net_G.pth> --out <dir>
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+import geocr_data as G
+import rescore as RS
+from models import networks
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--corpus", required=True)
+    ap.add_argument("--ckpt", required=True, help="directory holding final_net_G.pth")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--batch_size", type=int, default=16)
+    a = ap.parse_args()
+
+    ds = G.GeoCRPairDataset(a.corpus, "test")
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    ckpt = Path(a.ckpt) / "final_net_G.pth"
+    netG = networks.define_G(3, 3, 64, "global", 4, 9, norm="instance", gpu_ids=[]).to(device)
+    netG.load_state_dict(torch.load(ckpt, map_location="cpu", weights_only=True), strict=True)
+    netG.eval()
+
+    preds = Path(a.out) / "preds"
+    preds.mkdir(parents=True, exist_ok=True)
+    torch.set_grad_enabled(False)
+    for lo in range(0, len(ds), a.batch_size):
+        items = [ds[i] for i in range(lo, min(lo + a.batch_size, len(ds)))]
+        x01 = torch.from_numpy(np.stack([it[0] for it in items])).to(device)
+        pred01 = ((netG(x01 * 2.0 - 1.0).float().cpu() + 1.0) / 2.0).numpy()
+        for p, (_, _, sid) in zip(pred01, items):
+            np.save(preds / f"{Path(G.sid_flat(sid)).stem}.npy",
+                    np.ascontiguousarray(p, dtype=np.float32))
+
+    cfg = ds.cfg
+    man = {"corpus": cfg["corpus"], "split": "test",
+           "split_list_sha256": G.split_sha256(cfg, "test"), "n_items": len(ds),
+           "resolution": list(cfg["resolution"]), "crop": "none", "bands": list(cfg["bands"]),
+           "domain": cfg["domain"], "processing_level": cfg["level"],
+           "ckpt_selection": "final", "train_split_sha256": G.split_sha256(cfg, "trainval"),
+           "method": "pix2pixhd", "ckpt_sha256": RS.sha256_file(ckpt)}
+    missing = [k for k in RS.IDENTITY_KEYS if k not in man]
+    if missing:
+        raise SystemExit(f"manifest lacks {missing}")
+    (Path(a.out) / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"{len(ds)} predictions -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
