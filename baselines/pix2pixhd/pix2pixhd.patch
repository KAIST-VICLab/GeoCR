--- /dev/null
+++ b/geocr_data.py
@@ -0,0 +1,57 @@
+"""GeoCR data adapter: ids from <dataset root>/splits/<split>.txt, pixels from the 8-bit RGB
+export <CR_EXPORTS>/<corpus>/<split>/{cloudy,clear}/<id>.png, paired by id."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+import rescore as RS
+
+CR_EXPORTS = Path(os.environ.get("CR_EXPORTS", "CR_exports"))
+CORPORA = ("tcloud", "cuhk_cr2", "sen2mtc_new_rgb", "sen12mscr_rgb", "whus2crv_rgb")
+SPLITS_DIR = "splits"
+
+
+def corpus_cfg(name: str) -> dict:
+    if name not in CORPORA:
+        raise SystemExit(f"no pix2pixHD config for {name!r}; choose from {CORPORA}")
+    return dict(RS.CORPORA[name], corpus=name)
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def split_sha256(cfg: dict, split: str) -> str:
+    return RS.sha256_file(Path(cfg["root"]) / SPLITS_DIR / f"{split}.txt")
+
+
+def _read_u8(p: Path) -> np.ndarray:
+    with Image.open(p) as im:
+        return np.asarray(im.convert("RGB"), dtype=np.uint8)
+
+
+class GeoCRPairDataset:
+    """Items are (cloudy, clear, id) as float32 CHW in [0, 1]; pair_u8 returns the stored HWC uint8."""
+
+    def __init__(self, corpus: str, split: str):
+        self.cfg = corpus_cfg(corpus)
+        self.split = split
+        self.ids = RS.read_split(Path(self.cfg["root"]), split, SPLITS_DIR)
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def pair_u8(self, idx: int):
+        sid = self.ids[idx]
+        d = CR_EXPORTS / self.cfg["corpus"] / self.split
+        name = Path(sid_flat(sid)).with_suffix(".png").name
+        return _read_u8(d / "cloudy" / name), _read_u8(d / "clear" / name), sid
+
+    def __getitem__(self, idx: int):
+        cy, cl, sid = self.pair_u8(idx)
+        f = lambda a: np.ascontiguousarray(a.transpose(2, 0, 1), dtype=np.float32) / 255.0  # noqa: E731
+        return f(cy), f(cl), sid
