+#!/usr/bin/env python
+"""Train pix2pixHD for exactly --max_steps updates (one G and one D step per batch).
+
+    python train_geocr.py --name <run> --checkpoints_dir runs $TRAIN_ARGS --seed 0
+
+TRAIN_ARGS come from configs/<corpus>.sh. The model, losses, optimizers and per-epoch LR decay are
+the repository's own; the epoch horizon is derived from --max_steps (constant LR for the first
+half of the epochs, linear decay over the second half). Writes final_net_{G,D}.pth.
+"""
+import math
+import random
+import time
+
+import numpy as np
+import torch
+from torch.autograd import Variable
+
+from data.custom_dataset_data_loader import CreateDataset
+from models.models import create_model
+from options.train_options import TrainOptions
+
+
+class GeoCRTrainOptions(TrainOptions):
+    def initialize(self):
+        TrainOptions.initialize(self)
+        self.parser.add_argument('--max_steps', type=int, required=True)
+        self.parser.add_argument('--seed', type=int, default=0)
+
+
+def seed_all(seed: int) -> None:
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+
+
+def main() -> int:
+    opt = GeoCRTrainOptions().parse()
+    seed_all(opt.seed)
+    dataset = CreateDataset(opt)
+    loader = torch.utils.data.DataLoader(
+        dataset, batch_size=opt.batchSize, shuffle=True, num_workers=int(opt.nThreads),
+        drop_last=True, generator=torch.Generator().manual_seed(opt.seed))
+    e_total = math.ceil(opt.max_steps / len(loader))
+    opt.niter = math.ceil(e_total / 2)
+    opt.niter_decay = e_total - opt.niter
+    print(f"n_train={len(dataset)} steps/epoch={len(loader)} "
+          f"epochs={opt.niter}+{opt.niter_decay} lr={opt.lr}")
+
+    model = create_model(opt)
+    optimizer_G, optimizer_D = model.module.optimizer_G, model.module.optimizer_D
+    t0, step, epoch = time.time(), 0, 1
+    model.train()
+    while step < opt.max_steps:
+        for data in loader:
+            losses, _ = model(Variable(data['label']), Variable(data['inst']),
+                              Variable(data['image']), Variable(data['feat']), infer=False)
+            losses = [torch.mean(x) if not isinstance(x, int) else x for x in losses]
+            loss_dict = dict(zip(model.module.loss_names, losses))
+            loss_D = (loss_dict['D_fake'] + loss_dict['D_real']) * 0.5
+            loss_G = loss_dict['G_GAN'] + loss_dict.get('G_GAN_Feat', 0) + loss_dict.get('G_VGG', 0)
+
+            optimizer_G.zero_grad()
+            loss_G.backward()
+            optimizer_G.step()
+
+            optimizer_D.zero_grad()
+            loss_D.backward()
+            optimizer_D.step()
+
+            step += 1
+            if step % 100 == 0 or step == opt.max_steps:
+                errs = " ".join(f"{k}={float(v):.4f}" for k, v in loss_dict.items())
+                print(f"[{step}/{opt.max_steps}] ep{epoch} {errs} ({time.time() - t0:.0f}s)",
+                      flush=True)
+            if step >= opt.max_steps:
+                break
+        if step < opt.max_steps:
+            if epoch > opt.niter:
+                model.module.update_learning_rate()
+            epoch += 1
+
+    model.module.save('final')
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
