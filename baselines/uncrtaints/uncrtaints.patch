--- /dev/null
+++ b/data/geocr_corpora.py
@@ -0,0 +1,280 @@
+"""Split-list datasets for SEN12MS-CR, WHUS2-CRv, Sen2_MTC_New, T-CLOUD and CUHK-CR."""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+from torch.utils.data import Dataset
+
+_WORK = Path(__file__).resolve().parents[2]
+CR_DATASETS = Path(os.environ.get("CR_DATASETS", _WORK / "CR_datasets"))
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", _WORK / "GeoCR"))
+GEOCR_BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+
+
+_G = {}
+
+
+def _geocr():
+    if _G:
+        return _G
+    if str(GEOCR_ROOT) not in sys.path:
+        sys.path.insert(0, str(GEOCR_ROOT))
+    if str(GEOCR_BASELINES) not in sys.path:
+        sys.path.insert(0, str(GEOCR_BASELINES))
+    try:
+        from geocr.data.benchmarks import _read_png, _read_tif, _resize_u8
+    except Exception as exc:
+        raise SystemExit(
+            f"cannot import geocr.data.benchmarks from {GEOCR_ROOT}: {exc}; set GEOCR_ROOT") from exc
+    _G.update(read_png=_read_png, read_tif=_read_tif, resize_u8=_resize_u8)
+    return _G
+
+
+def _fuse13():
+    _geocr()
+    try:
+        from exporters.export_whus2 import fuse13
+    except Exception as exc:
+        raise SystemExit(
+            f"cannot import exporters.export_whus2.fuse13 from {GEOCR_BASELINES}: {exc}; "
+            "set GEOCR_BASELINES") from exc
+    return fuse13
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def read_split(root: Path, split: str, splits_dir: str = "splits") -> list[str]:
+    p = Path(root) / splits_dir / f"{split}.txt"
+    if not p.is_file():
+        raise SystemExit(f"missing split file {p}")
+    out = [s for s in (ln.split("#", 1)[0].strip()
+                       for ln in p.read_text().splitlines()) if s]
+    if not out:
+        raise SystemExit(f"{p} is empty")
+    return out
+
+
+CORPORA: dict[str, dict] = {
+    "sen12mscr": dict(
+        kind="sen12", root=CR_DATASETS / "SEN12MS-CR", bands=13, res=256, k=1,
+        level="l1c_toa", domain="reflectance", splits_dir="splits", sar=True,
+        band_names=["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8",
+                    "B8A", "B9", "B10", "B11", "B12"],
+    ),
+    "whus2crv": dict(
+        kind="whus2", root=CR_DATASETS / "WHUS2-CRv" / "extracted", bands=13,
+        res=384, k=1, level="boa", domain="reflectance", splits_dir="splits",
+        sar=False,
+        band_names=["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8",
+                    "B8A", "B9", "B10", "B11", "B12"],
+    ),
+    "sen2mtc_new": dict(
+        kind="mtc", root=CR_DATASETS / "Sen2_MTC_New", bands=4, res=256, k=3,
+        level="boa", domain="reflectance", splits_dir="splits", sar=False,
+        band_names=["R", "G", "B", "NIR"],
+    ),
+    "tcloud": dict(
+        kind="display8", root=CR_DATASETS / "T-CLOUD", bands=3, res=256, k=1,
+        native=256, level="display8", domain="unit_float", splits_dir="splits",
+        sar=False, nir=False, band_names=["R", "G", "B"],
+        clear_sub=[("/cloud/", "/reference/"), ("/cloud/", "/label/")],
+    ),
+    "cuhk_cr1": dict(
+        kind="display8", root=CR_DATASETS / "C-CUHK" / "CUHK-CR1", bands=4,
+        res=256, k=1, native=512, level="display8", domain="unit_float",
+        splits_dir="splits", sar=False, nir=True,
+        band_names=["R", "G", "B", "NIR"],
+        clear_sub=[("/cloud/", "/label/")],
+    ),
+    "cuhk_cr2": dict(
+        kind="display8", root=CR_DATASETS / "C-CUHK" / "CUHK-CR2", bands=3,
+        res=256, k=1, native=512, level="display8", domain="unit_float",
+        splits_dir="splits", sar=False, nir=False, band_names=["R", "G", "B"],
+        clear_sub=[("/cloud/", "/label/")],
+    ),
+}
+
+ALIASES = {"cuhk_cr": "cuhk_cr1"}
+
+
+def resolve(name: str) -> str:
+    name = ALIASES.get(name, name)
+    if name not in CORPORA:
+        raise SystemExit(f"unknown corpus {name!r}; have {sorted(CORPORA)} "
+                         f"(aliases {ALIASES})")
+    return name
+
+
+def _zeros_mask(h: int, w: int) -> np.ndarray:
+    return np.zeros((h, w), dtype=np.float32)
+
+
+class _Base(Dataset):
+    def __init__(self, corpus: str, split: str, root=None, splits_dir=None,
+                 split_list=None, export_root=None):
+        self.corpus = resolve(corpus)
+        self.cfg = CORPORA[self.corpus]
+        self.split = split
+        self.root = Path(root) if root else self.cfg["root"]
+        self.splits_dir = splits_dir or self.cfg["splits_dir"]
+        self.export_root = Path(export_root) if export_root else None
+        if split_list:
+            p = Path(split_list)
+            if not p.is_file():
+                raise SystemExit(f"--split_list {p} does not exist")
+            self.split_file = p
+            self.ids = [s for s in (ln.split("#", 1)[0].strip()
+                                    for ln in p.read_text().splitlines()) if s]
+        else:
+            self.split_file = Path(self.root) / self.splits_dir / f"{split}.txt"
+            self.ids = read_split(self.root, split, self.splits_dir)
+        self.export_split = self.split_file.stem
+        self.res = self.cfg["res"]
+
+    def __len__(self):
+        return len(self.ids)
+
+
+class Sen12MSCRSplit(_Base):
+
+    def __init__(self, *a, use_sar=True, **kw):
+        super().__init__(*a, **kw)
+        self.use_sar = use_sar
+
+    def __getitem__(self, i):
+        from data.dataLoader import process_MS, process_SAR, read_img, read_tif
+        sid = self.ids[i]
+        p_cloudy = self.root / sid
+        p_clear = self.root / sid.replace("s2_cloudy", "s2")
+        x = process_MS(read_img(read_tif(p_cloudy)), "default").astype(np.float32)
+        y = process_MS(read_img(read_tif(p_clear)), "default").astype(np.float32)
+        sample = {
+            "input": {"S2": x, "masks": _zeros_mask(*x.shape[-2:]),
+                      "coverage": np.float32(0.0), "S2 path": str(p_cloudy)},
+            "target": {"S2": y, "S2 path": str(p_clear)},
+            "sid": sid,
+        }
+        if self.use_sar:
+            p_s1 = self.root / sid.replace("s2_cloudy", "s1")
+            sample["input"]["S1"] = process_SAR(
+                read_img(read_tif(p_s1)), "default").astype(np.float32)
+        return sample
+
+
+class WHUS2Dataset(_Base):
+
+    def __getitem__(self, i):
+        from data.dataLoader import process_MS
+        fuse13 = _fuse13()
+        sid = self.ids[i]
+        x = process_MS(fuse13(self.root, sid, "cloud").astype(np.float32),
+                       "default").astype(np.float32)
+        y = process_MS(fuse13(self.root, sid, "clear").astype(np.float32),
+                       "default").astype(np.float32)
+        return {"input": {"S2": x, "masks": _zeros_mask(*x.shape[-2:]),
+                          "coverage": np.float32(0.0), "S2 path": sid},
+                "target": {"S2": y, "S2 path": sid},
+                "sid": sid}
+
+
+class Sen2MTCNewDataset(_Base):
+
+    def __getitem__(self, i):
+        from data.dataLoader import process_MS
+        g = _geocr()
+        sid = self.ids[i]
+        target = self.root / sid
+        cloud_dir = target.parent.parent / "cloud"
+        frames = [cloud_dir / f"{target.stem}_{t}.tif" for t in range(self.cfg["k"])]
+        missing = [p for p in frames if not p.is_file()]
+        if missing:
+            raise FileNotFoundError(
+                f"{missing[0]}: expected cloud frames {target.stem}_{{0,1,2}}.tif")
+        xs = [process_MS(g["read_tif"](p).astype(np.float32), "default").astype(np.float32)
+              for p in frames]
+        y = process_MS(g["read_tif"](target).astype(np.float32), "default").astype(np.float32)
+        h, w = y.shape[-2:]
+        return {"input": {"S2": xs,
+                          "masks": [_zeros_mask(h, w) for _ in xs],
+                          "S2 TD": [np.int64(t) for t in range(len(xs))],
+                          "coverage": [np.float32(0.0) for _ in xs]},
+                "target": {"S2": [y]},
+                "sid": sid}
+
+
+class Display8Dataset(_Base):
+
+    def _native(self, sid, role):
+        g = _geocr()
+        cfg = self.cfg
+        if role == "clear":
+            for needle, repl in cfg["clear_sub"]:
+                cand = sid.replace(needle, repl)
+                if (self.root / cand).is_file():
+                    sid = cand
+                    break
+            else:
+                raise FileNotFoundError(
+                    f"{sid}: no clear pair via {cfg['clear_sub']} under {self.root}")
+        rgb = g["resize_u8"](g["read_png"](self.root / sid), self.res)
+        chans = [rgb[..., c] for c in range(3)]
+        if cfg["nir"]:
+            nir_root = self.root.parent / "nir" / self.root.name
+            arr = g["read_png"](nir_root / sid)
+            arr = arr[..., 0] if arr.ndim == 3 else arr
+            chans.append(g["resize_u8"](arr, self.res))
+        return np.stack(chans, 0).astype(np.float32) / 255.0
+
+    def _export(self, sid, role):
+        g = _geocr()
+        d = self.export_root / self.corpus / self.export_split
+        key = Path(sid_flat(sid)).with_suffix(".png").name
+        rgb = g["read_png"](d / role / key)
+        chans = [rgb[..., c] for c in range(3)]
+        if self.cfg["nir"]:
+            arr = g["read_png"](d / f"{role}_nir" / key)
+            chans.append(arr[..., 0] if arr.ndim == 3 else arr)
+        return np.stack(chans, 0).astype(np.float32) / 255.0
+
+    def __getitem__(self, i):
+        sid = self.ids[i]
+        load = self._export if self.export_root else self._native
+        x, y = load(sid, "cloudy"), load(sid, "clear")
+        return {"input": {"S2": x, "masks": _zeros_mask(*x.shape[-2:]),
+                          "coverage": np.float32(0.0), "S2 path": sid},
+                "target": {"S2": y, "S2 path": sid},
+                "sid": sid}
+
+
+_KINDS = {"sen12": Sen12MSCRSplit, "whus2": WHUS2Dataset,
+          "mtc": Sen2MTCNewDataset, "display8": Display8Dataset}
+
+
+def build_dataset(config, split: str):
+    from src.geocr_bands import S2_BANDS
+    corpus = resolve(config.corpus)
+    cfg = CORPORA[corpus]
+    if S2_BANDS != cfg["bands"]:
+        raise SystemExit(
+            f"band-width mismatch: corpus {corpus!r} has {cfg['bands']} bands but "
+            f"UNCR_S2_BANDS={S2_BANDS}.\n"
+            f"  export UNCR_S2_BANDS={cfg['bands']} before launching (see model/src/geocr_bands.py)")
+    if cfg["sar"] and getattr(config, "use_sar", False) and cfg["kind"] != "sen12":
+        raise SystemExit(f"--use_sar is not available for corpus {corpus!r}")
+    if not cfg["sar"] and getattr(config, "use_sar", False):
+        raise SystemExit(
+            f"corpus {corpus!r} ships no SAR; drop --use_sar")
+    kw = dict(root=config.corpus_root or None,
+              splits_dir=config.splits_dir or None,
+              export_root=config.export_root or None)
+    if split == "train" and getattr(config, "split_list", ""):
+        kw["split_list"] = config.split_list
+    cls = _KINDS[cfg["kind"]]
+    if cls is Sen12MSCRSplit:
+        return cls(corpus, split, use_sar=bool(config.use_sar), **kw)
+    return cls(corpus, split, **kw)
