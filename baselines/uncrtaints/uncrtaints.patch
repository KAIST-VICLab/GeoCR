@@ -0,0 +1,226 @@
+"""Write UnCRtainTS test predictions as CHW .npy files plus a manifest."""
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+dirname = os.path.dirname(os.path.abspath(__file__))
+sys.path.append(os.path.dirname(dirname))
+
+from parse_args import create_parser
+from src import utils
+from src.geocr_bands import S2_BANDS
+from src.model_utils import get_model, load_checkpoint
+
+CODE_PATCHES = [
+    "data/dataLoader.py: exact ROI split match; optional s2cloudless import",
+    "model/src/backbones/base_model.py: optional fvcore import",
+    "model/train_reconstruct.py: plot band indices, plot file ids, --corpus datasets, "
+    "--max_steps, --early_stop_patience, --save_every_epoch, --ckpt_selection",
+    "model/test_reconstruct.py: keep --batch_size from the command line",
+    "model/parse_args.py: new flags",
+    "S2_BANDS read from src/geocr_bands.py (UNCR_S2_BANDS)",
+]
+
+
+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def git_rev(repo):
+    try:
+        return subprocess.check_output(
+            ["git", "-C", str(repo), "rev-parse", "--short", "HEAD"],
+            text=True, stderr=subprocess.DEVNULL).strip()
+    except Exception:
+        return "unknown"
+
+
+def build_config():
+    parser = create_parser(mode="test")
+    cli = parser.parse_args()
+    conf = (Path(cli.load_config) if cli.load_config else
+            Path(dirname) / cli.weight_folder / cli.experiment_name / "conf.json")
+    if conf.is_file():
+        no_overwrite = [
+            "pid", "device", "resume_at", "trained_checkp", "res_dir",
+            "weight_folder", "root1", "root2", "root3", "max_samples_count",
+            "batch_size", "display_step", "plot_every", "export_every",
+            "input_t", "region", "min_cov", "max_cov",
+            "corpus", "corpus_root", "splits_dir", "split_list", "export_root",
+            "dump_dir", "dump_split", "method_name", "run_id", "dump_fp16",
+            "num_workers",
+        ]
+        d = {k: v for k, v in json.loads(conf.read_text()).items()
+             if k not in no_overwrite}
+        for k, v in vars(cli).items():
+            if k in no_overwrite:
+                d[k] = v
+        ns = argparse.Namespace()
+        ns.__dict__.update(d)
+        cfg = parser.parse_args(namespace=ns)
+    else:
+        print(f"WARNING: no conf.json at {conf}; using CLI flags alone.")
+        cfg = cli
+    return utils.str2list(cfg, ["encoder_widths", "decoder_widths", "out_conv"]), conf
+
+
+def main():
+    config, conf_path = build_config()
+    if not config.corpus:
+        raise SystemExit("--corpus is required")
+    if not config.dump_dir:
+        raise SystemExit("--dump_dir is required")
+
+    from data.geocr_corpora import CORPORA, build_dataset, resolve, sid_flat
+    from train_reconstruct import prepare_data
+
+    corpus = resolve(config.corpus)
+    ccfg = CORPORA[corpus]
+    ds = build_dataset(config, config.dump_split)
+    if S2_BANDS != ccfg["bands"]:
+        raise SystemExit(f"UNCR_S2_BANDS={S2_BANDS} but {corpus} has {ccfg['bands']}")
+
+    device = torch.device(config.device)
+    model = get_model(config).to(device)
+    ckpt_n = f"_epoch_{config.resume_at}" if config.resume_at > 0 else ""
+    load_checkpoint(config, config.weight_folder, model, f"model{ckpt_n}")
+    ckpt = Path(dirname) / config.weight_folder / config.experiment_name / f"model{ckpt_n}.pth.tar"
+    model.eval()
+    model.netG.eval()
+
+    out_dir = (Path(config.dump_dir) / corpus / config.dump_split /
+               config.method_name / (config.run_id or "run"))
+    (out_dir / "preds").mkdir(parents=True, exist_ok=True)
+
+    loader = torch.utils.data.DataLoader(
+        ds, batch_size=config.batch_size, shuffle=False,
+        num_workers=config.num_workers)
+
+    dtype = np.float16 if config.dump_fp16 else np.float32
+    if config.dump_fp16 and len(ds) < 5000:
+        raise SystemExit(f"float16 dumps are only used for splits of >= 5,000 items ({len(ds)} here)")
+
+    written, t0 = [], time.time()
+    with torch.no_grad():
+        for batch in loader:
+            sids = batch["sid"]
+            if config.sample_type == "pretrain":
+                x, y, m = prepare_data(batch, device, config)
+                dates = None
+            else:
+                x, y, m, dates = prepare_data(batch, device, config)
+            model.set_input({"A": x, "B": y, "dates": dates, "masks": m})
+            model.forward()
+            model.get_loss_G()
+            model.rescale()
+            pred = model.fake_B[:, 0, :S2_BANDS].float().cpu().numpy()
+            for b, sid in enumerate(sids):
+                stem = Path(sid_flat(sid)).stem
+                np.save(out_dir / "preds" / f"{stem}.npy", pred[b].astype(dtype))
+                written.append(stem)
+
+    expect = [Path(sid_flat(s)).stem for s in ds.ids]
+    if sorted(written) != sorted(expect) or len(set(written)) != len(expect):
+        raise SystemExit(
+            f"dump key set != split list: wrote {len(set(written))} unique of "
+            f"{len(written)} for {len(expect)} ids. Refusing to write a manifest.")
+
+    split_file = Path(ds.split_file)
+    train_conf = json.loads(conf_path.read_text()) if conf_path.is_file() else {}
+    train_file = Path(ds.root) / ds.splits_dir / "train.txt"
+    if train_conf.get("split_list"):
+        train_file = Path(train_conf["split_list"])
+    elif config.split_list:
+        train_file = Path(config.split_list)
+    trainlog = (Path(dirname) / config.weight_folder / config.experiment_name /
+                "trainlog.json")
+    epochs_used = None
+    if trainlog.is_file():
+        try:
+            epochs_used = max(int(k) for k in json.loads(trainlog.read_text()))
+        except Exception:
+            pass
+    n_train = sum(1 for ln in train_file.read_text().splitlines()
+                  if ln.split("#", 1)[0].strip()) if train_file.is_file() else None
+    native = ccfg.get("native", ccfg["res"])
+
+    if ccfg["kind"] == "display8":
+        resample = {"op": "PIL.BICUBIC",
+                    "via": "geocr.data.benchmarks._resize_u8",
+                    "where": "exporter" if config.export_root else "loader",
+                    "stage": "pre-inference"} if native != ccfg["res"] else \
+                   {"op": "none", "where": "n/a", "stage": "n/a"}
+    elif ccfg["kind"] == "whus2":
+        resample = {"op": "nearest-replication onto the 10 m grid",
+                    "via": "exporters/export_whus2.py::fuse13",
+                    "where": "loader", "stage": "pre-inference"}
+    else:
+        resample = {"op": "none", "where": "n/a", "stage": "n/a"}
+
+    man = {
+        "corpus": corpus, "split": config.dump_split,
+        "split_list": str(split_file), "split_list_sha256": sha256_file(split_file),
+        "n_items": len(expect),
+        "resolution": [ccfg["res"], ccfg["res"]],
+        "crop": "none",
+        "bands": list(ccfg["band_names"]),
+        "domain": ccfg["domain"],
+        "processing_level": ccfg["level"],
+        "native_resolution": [native, native],
+        "resample": resample,
+        "dtype": "float16" if config.dump_fp16 else "float32",
+        "method": config.method_name,
+        "method_variant": f"loss={config.loss}; covmode={config.covmode}; "
+                          f"use_sar={bool(config.use_sar)}; scale_by={config.scale_by}; "
+                          f"s2_bands={S2_BANDS}",
+        "code_rev": git_rev(Path(dirname).parent),
+        "code_patches": CODE_PATCHES,
+        "surgery": ("band count UNCR_S2_BANDS=%d" % S2_BANDS) if S2_BANDS != 13 else "none",
+        "ckpt": str(ckpt), "ckpt_sha256": sha256_file(ckpt) if ckpt.is_file() else None,
+        "ckpt_selection": ("final"
+                           if train_conf.get("ckpt_selection",
+                                             getattr(config, "ckpt_selection", "best_on_dev"))
+                           == "final" else "best_on_dev(val_loss)"),
+        "ema": False,
+        "train_split": str(train_file),
