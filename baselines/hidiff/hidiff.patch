@@ -0,0 +1,64 @@
+"""GeoCR data adapter for the test split: ids from <dataset root>/splits/test.txt, pixels from the
+8-bit RGB export <CR_EXPORTS>/<corpus>/test/{cloudy,clear}/<id>.png. Training reads the same export
+through PairedImageIRDataset (configs/<corpus>_s{1,2}.yml)."""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+import rescore as RS
+
+CR_EXPORTS = Path(os.environ.get("CR_EXPORTS", "CR_exports"))
+CORPORA = ("tcloud", "cuhk_cr2", "sen2mtc_new_rgb", "sen12mscr_rgb", "whus2crv_rgb")
+SPLITS_DIR = "splits"
+
+
+def corpus_cfg(name: str) -> dict:
+    if name not in CORPORA:
+        raise SystemExit(f"no HI-Diff config for {name!r}; choose from {CORPORA}")
+    return dict(RS.CORPORA[name], corpus=name)
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def split_sha256(cfg: dict, split: str) -> str:
+    return RS.sha256_file(Path(cfg["root"]) / SPLITS_DIR / f"{split}.txt")
+
+
+def sample_noise(sid: str, shape, seed: int) -> torch.Tensor:
+    """Initial prior noise for one sample, from a generator seeded with blake2b of (seed, id)."""
+    key = hashlib.blake2b(f"{seed}:{sid}".encode(), digest_size=8).digest()
+    g = torch.Generator(device="cpu").manual_seed(int.from_bytes(key, "big"))
+    return torch.randn(*shape, generator=g, dtype=torch.float32)
+
+
+class GeoCRPairs(Dataset):
+    """Items are (cloudy, clear, id) with float32 RGB tensors [3, 256, 256] in [0, 1]."""
+
+    def __init__(self, corpus: str, split: str):
+        self.cfg = corpus_cfg(corpus)
+        self.export = CR_EXPORTS / corpus / split
+        self.sids = RS.read_split(Path(self.cfg["root"]), split, SPLITS_DIR)
+
+    def __len__(self) -> int:
+        return len(self.sids)
+
+    def _png(self, role: str, sid: str) -> torch.Tensor:
+        p = self.export / role / Path(sid_flat(sid)).with_suffix(".png").name
+        a = cv2.imread(str(p), cv2.IMREAD_COLOR)
+        if a is None:
+            raise FileNotFoundError(p)
+        a = a[:, :, ::-1]
+        return torch.from_numpy(np.ascontiguousarray(a.transpose(2, 0, 1), dtype=np.float32) / 255.0)
+
+    def __getitem__(self, idx: int):
+        sid = self.sids[idx]
+        return self._png("cloudy", sid), self._png("clear", sid), sid
