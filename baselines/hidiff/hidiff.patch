+#!/usr/bin/env python
+"""Write test-set predictions for geocr.eval: <out>/preds/<id>.npy (float32 CHW in [0, 1],
+unclipped) and <out>/manifest.json.
+
+    python dump.py --corpus <corpus> --config <configs/<corpus>_s2.yml> \
+        --ckpt <dir with net_g_latest.pth, net_le_dm_latest.pth, net_d_latest.pth> --out <dir>
+
+The stage-2 model runs in test mode: net_le_dm encodes the cloudy image, the prior is denoised
+over the configured timesteps (posterior mean) from noise seeded per image from (seed, id), and
+net_g restores the image. The stage-1 encoder net_le is not used at test time.
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from torch.utils.data import DataLoader
+
+import geocr_data as G
+import rescore as RS
+
+
+def build_model(cfg_path: Path, ckpt: Path, num_gpu: int):
+    import hi_diff  # noqa: F401  (registers the archs and models)
+    from hi_diff.models.HI_Diff_S2_model import HI_Diff_S2
+    from hi_diff.utils.options import ordered_yaml
+    with open(cfg_path, encoding="utf-8") as f:
+        opt = yaml.load(f, Loader=ordered_yaml()[0])
+    opt.update(is_train=False, dist=False, rank=0, world_size=1, num_gpu=num_gpu)
+    opt["path"]["pretrain_network_le"] = None
+    for key in ("g", "le_dm", "d"):
+        opt["path"][f"pretrain_network_{key}"] = str(ckpt / f"net_{key}_latest.pth")
+        opt["path"][f"strict_load_{key}"] = True
+        opt["path"][f"param_key_{key}"] = "params"
+    model = HI_Diff_S2(opt)
+    for net in (model.net_g, model.net_le, model.net_le_dm, model.net_d):
+        net.eval()
+    return model
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--corpus", required=True)
+    ap.add_argument("--config", required=True, help="the stage-2 config")
+    ap.add_argument("--ckpt", required=True, help="directory holding the stage-2 net_*_latest.pth")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--batch-size", type=int, default=8)
+    ap.add_argument("--num-workers", type=int, default=4)
+    a = ap.parse_args()
+
+    ds = G.GeoCRPairs(a.corpus, "test")
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    ckpt = Path(a.ckpt)
+    model = build_model(Path(a.config), ckpt, num_gpu=int(device.type == "cuda"))
+
+    preds = Path(a.out) / "preds"
+    preds.mkdir(parents=True, exist_ok=True)
+    loader = DataLoader(ds, batch_size=a.batch_size, shuffle=False, num_workers=a.num_workers)
+    with torch.no_grad():
+        for cloudy, _clear, sids in loader:
+            img = cloudy.to(device)
+            prior_c = model.net_le_dm(img)
+            noise = torch.stack([G.sample_noise(s, tuple(prior_c.shape[1:]), a.seed) for s in sids]
+                                ).to(device=device, dtype=prior_c.dtype)
+            out = model.net_g(img, model.p_sample_loop(prior_c, noise))
+            for arr, sid in zip(out.float().cpu().numpy(), sids):
+                np.save(preds / f"{Path(G.sid_flat(sid)).stem}.npy", np.asarray(arr, dtype=np.float32))
+
+    cfg = ds.cfg
+    man = {"corpus": cfg["corpus"], "split": "test",
+           "split_list_sha256": G.split_sha256(cfg, "test"), "n_items": len(ds),
+           "resolution": list(cfg["resolution"]), "crop": "none", "bands": list(cfg["bands"]),
+           "domain": cfg["domain"], "processing_level": cfg["level"],
+           "ckpt_selection": "final", "train_split_sha256": G.split_sha256(cfg, "trainval"),
+           "method": "hidiff", "seed": a.seed,
+           "ckpt_sha256": RS.sha256_file(ckpt / "net_g_latest.pth")}
+    missing = [k for k in RS.IDENTITY_KEYS if k not in man]
+    if missing:
+        raise SystemExit(f"manifest lacks {missing}")
+    (Path(a.out) / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"{len(ds)} predictions -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
