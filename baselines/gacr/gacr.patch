@@ -0,0 +1,312 @@
+"""Split-list dataset, keyed noise and output-domain mapping for GACR."""
+from __future__ import annotations
+
+import hashlib
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+_WORK = Path(__file__).resolve().parents[1]
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", _WORK / "GeoCR"))
+BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+CR_DATASETS = Path(os.environ.get("CR_DATASETS", _WORK / "CR_datasets"))
+
+for _p in (str(GEOCR_ROOT), str(BASELINES / "exporters")):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+
+def geocr_helpers():
+    from geocr.data.benchmarks import _read_png, _read_tif, _resize_u8
+    return dict(read_png=_read_png, read_tif=_read_tif, resize_u8=_resize_u8)
+
+
+CORPORA: dict[str, dict] = {
+    "tcloud": dict(
+        root=CR_DATASETS / "T-CLOUD", kind="display8", c_target=3, k=1,
+        res=256, native=256, level="display8", lineage="tcloud",
+        bands=["R", "G", "B"], domain="unit_float", dev_key="tcloud_psnr",
+        clear_sub=[("/cloud/", "/reference/"), ("/cloud/", "/label/")], nir=False,
+    ),
+    "cuhk_cr1": dict(
+        root=CR_DATASETS / "C-CUHK" / "CUHK-CR1", kind="display8", c_target=4,
+        k=1, res=256, native=512, level="display8", lineage="cuhk",
+        bands=["R", "G", "B", "NIR"], domain="unit_float", dev_key="cuhk_psnr",
+        clear_sub=[("/cloud/", "/label/")], nir=True,
+    ),
+    "cuhk_cr2": dict(
+        root=CR_DATASETS / "C-CUHK" / "CUHK-CR2", kind="display8", c_target=3,
+        k=1, res=256, native=512, level="display8", lineage="cuhk_rgb",
+        bands=["R", "G", "B"], domain="unit_float", dev_key="cuhkrgb_psnr",
+        clear_sub=[("/cloud/", "/label/")], nir=False,
+    ),
+    "sen2mtc_new": dict(
+        root=CR_DATASETS / "Sen2_MTC_New", kind="sen2mtc_new", c_target=4, k=3,
+        res=256, native=256, level="boa", lineage="sen2mtc",
+        bands=["R", "G", "B", "NIR"], domain="reflectance", dev_key="mtc_psnr",
+    ),
+    "whus2crv": dict(
+        root=CR_DATASETS / "WHUS2-CRv" / "extracted", kind="whus2crv",
+        c_target=13, k=1, res=384, native=384, level="boa", lineage="masked13",
+        bands=None, domain="reflectance", dev_key="psnr_all",
+    ),
+    "sen12mscr": dict(
+        root=CR_DATASETS / "SEN12MS-CR", kind="sen12mscr", c_target=13, k=1,
+        res=256, native=256, level="l1c_toa", lineage="masked13",
+        bands=None, domain="reflectance", dev_key="psnr_all",
+    ),
+}
+
+ALIASES = {"cuhk_cr": "cuhk_cr1"}
+
+
+def corpus_cfg(name: str) -> dict:
+    name = ALIASES.get(name, name)
+    if name not in CORPORA:
+        raise SystemExit(f"unknown corpus {name!r}; known: {sorted(CORPORA)}")
+    cfg = dict(CORPORA[name])
+    cfg["name"] = name
+    if cfg["bands"] is None:
+        from geocr.normalize import S2_BANDS
+        cfg["bands"] = list(S2_BANDS)
+    return cfg
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def read_split(root: Path, split: str, splits_dir: str = "splits") -> list[str]:
+    p = Path(root) / splits_dir / f"{split}.txt"
+    if not p.is_file():
+        raise SystemExit(f"missing split file {p}")
+    out = [s for s in (ln.split("#", 1)[0].strip()
+                       for ln in p.read_text().splitlines()) if s]
+    if not out:
+        raise SystemExit(f"{p} is empty")
+    return out
+
+
+def split_sha256(root: Path, split: str, splits_dir: str = "splits") -> str:
+    h = hashlib.sha256()
+    with open(Path(root) / splits_dir / f"{split}.txt", "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def sample_noise(sid: str, shape, seed: int, device=None) -> torch.Tensor:
+    key = hashlib.blake2b(f"{seed}:{sid}".encode(), digest_size=8).digest()
+    g = torch.Generator(device="cpu").manual_seed(int.from_bytes(key, "big"))
+    z = torch.randn(*shape, generator=g, dtype=torch.float32)
+    return z if device is None else z.to(device)
+
+
+class GeoCRSplitDataset(Dataset):
+
+    def __init__(self, corpus: str, split: str, splits_dir: str = "splits",
+                 root: str | Path | None = None, max_items: int | None = None,
+                 cond_frames: int | None = None, anchor_frame: int = 0,
+                 rgb_view: str = "model_norm"):
+        self.cfg = corpus_cfg(corpus)
+        self.corpus = self.cfg["name"]
+        self.root = Path(root) if root else self.cfg["root"]
+        self.split = split
+        self.splits_dir = splits_dir
+        self.res = int(self.cfg["res"])
+        self.ids = read_split(self.root, split, splits_dir)
+        if max_items is not None:
+            self.ids = self.ids[:int(max_items)]
+        self.k = int(self.cfg["k"] if cond_frames is None else cond_frames)
+        if not 1 <= self.k <= int(self.cfg["k"]):
+            raise SystemExit(f"cond_frames={self.k} outside 1..{self.cfg['k']} "
+                             f"for {self.corpus}")
+        self.anchor = int(anchor_frame)
+        if rgb_view not in ("model_norm", "display_gain2"):
+            raise SystemExit(f"unknown gcpa rgb_view {rgb_view!r}")
+        self.rgb_view = rgb_view
+        self._h = None
+        self._norms = None
+
+    @property
+    def h(self):
+        if self._h is None:
+            self._h = geocr_helpers()
+        return self._h
+
+    @property
+    def norms(self):
+        if self._norms is None:
+            from geocr.normalize import Norms
+            self._norms = Norms()
+        return self._norms
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def _u8(self, path: Path, want_nir_from: Path | None) -> np.ndarray:
+        rgb = self.h["resize_u8"](self.h["read_png"](path), self.res)
+        if rgb.ndim == 2:
+            rgb = rgb[..., None]
+        rgb = rgb[..., :3]
+        if want_nir_from is None:
+            return rgb
+        n = self.h["read_png"](want_nir_from)
+        n = n[..., 0] if n.ndim == 3 else n
+        return np.concatenate([rgb, self.h["resize_u8"](n, self.res)[..., None]], -1)
+
+    def _display8(self, sid: str) -> tuple[torch.Tensor, torch.Tensor]:
+        cid = None
+        for needle, repl in self.cfg["clear_sub"]:
+            if needle in sid and (self.root / sid.replace(needle, repl)).is_file():
+                cid = sid.replace(needle, repl)
+                break
+        if cid is None:
+            raise FileNotFoundError(f"{sid}: no clear pair under {self.root}")
+        nir_root = (self.root.parent / "nir" / self.root.name
+                    if self.cfg["nir"] else None)
+        cl = self._u8(self.root / cid, nir_root / cid if nir_root else None)
+        cy = self._u8(self.root / sid, nir_root / sid if nir_root else None)
+        f = lambda a: torch.from_numpy(
+            np.ascontiguousarray(a.transpose(2, 0, 1))).float() / 255.0 * 2.0 - 1.0
+        return f(cl), f(cy)[None]
+
+    def _refl13_to_model(self, refl: torch.Tensor) -> torch.Tensor:
+        from geocr.normalize import MS_IDX, RGB_IDX
+        s2 = self.norms.s2
+        out = torch.empty_like(refl)
+        out[list(RGB_IDX)] = s2.rgb_to_model(refl[list(RGB_IDX)][None])[0]
+        out[list(MS_IDX)] = s2.ms_to_model(refl[list(MS_IDX)][None])[0]
+        return out
+
+    def _refl4_to_model(self, refl: torch.Tensor) -> torch.Tensor:
+        s2 = self.norms.s2
+        return torch.cat([s2.rgb_to_model(refl[:3][None])[0],
+                          s2.ms_to_model(refl[3:4][None])[0]], 0)
+
+    def _sen2mtc(self, sid: str):
+        target = self.root / sid
+        cloud_dir = target.parent.parent / "cloud"
+        frames = [cloud_dir / f"{target.stem}_{i}.tif" for i in range(3)]
+        missing = [p for p in frames if not p.is_file()]
+        if missing:
+            raise FileNotFoundError(
+                f"{missing[0]}: expected cloud frames {target.stem}_{{0,1,2}}.tif")
+        rd = lambda p: torch.from_numpy(
+            self.h["read_tif"](p).astype(np.float32)) / 10000.0
+        clear = self._refl4_to_model(rd(target))
+        cond = torch.stack([self._refl4_to_model(rd(p)) for p in frames])
+        return clear, cond
+
+    def _whus2(self, sid: str):
+        from export_whus2 import fuse13
+        g = dict(read_tif=self.h["read_tif"])
+        from geocr.data.benchmarks import WHUS2CRvProvider
+        g["whus2"] = WHUS2CRvProvider
+        rd = lambda role: self._refl13_to_model(torch.from_numpy(
+            fuse13(self.root, sid, role, g).astype(np.float32)) / 10000.0)
+        return rd("clear"), rd("cloud")[None]
+
+    def _sen12mscr(self, sid: str):
+        rd = lambda p: self._refl13_to_model(torch.from_numpy(
+            self.h["read_tif"](p).astype(np.float32)) / 10000.0)
+        return rd(self.root / sid.replace("s2_cloudy", "s2")), \
+            rd(self.root / sid)[None]
+
+    def _rgb_view(self, clear_model: torch.Tensor) -> torch.Tensor:
+        if self.cfg["c_target"] == 3:
+            return clear_model
+        if self.cfg["level"] == "display8":
+            return clear_model[:3]
+        from geocr.normalize import RGB_IDX, RGBVariantNorm
+        idx = list(RGB_IDX) if self.cfg["c_target"] == 13 else [0, 1, 2]
+        if self.rgb_view == "model_norm":
+            return clear_model[idx]
+        refl = self.norms.s2.rgb_to_refl(clear_model[idx][None])
+        return RGBVariantNorm().to_u01(refl)[0] * 2.0 - 1.0
+
+    def __getitem__(self, idx: int) -> dict:
+        sid = self.ids[idx]
+        kind = self.cfg["kind"]
+        if kind == "display8":
+            clear, frames = self._display8(sid)
+        elif kind == "sen2mtc_new":
+            clear, frames = self._sen2mtc(sid)
+        elif kind == "whus2crv":
+            clear, frames = self._whus2(sid)
+        elif kind == "sen12mscr":
+            clear, frames = self._sen12mscr(sid)
+        else:
+            raise SystemExit(f"no loader for kind {kind!r}")
+        frames = frames[: self.k]
+        return {
+            "clear": clear,
+            "cloudy": frames[self.anchor],
+            "cond": frames.reshape(-1, *frames.shape[-2:]),
+            "rgb": self._rgb_view(clear),
+            "sid": sid,
+            "filename": str(self.root / sid),
+        }
+
+
+def to_dump_domain(x_model: torch.Tensor, cfg: dict) -> torch.Tensor:
+    from geocr.normalize import MS_IDX, RGB_IDX, Norms
+    squeeze = x_model.dim() == 3
+    x = x_model[None] if squeeze else x_model
+    if cfg["level"] == "display8":
+        out = (x + 1.0) / 2.0
+    else:
+        s2 = Norms().s2
+        out = torch.empty_like(x)
+        if cfg["c_target"] == 13:
+            out[:, list(RGB_IDX)] = s2.rgb_to_refl(x[:, list(RGB_IDX)])
+            out[:, list(MS_IDX)] = s2.ms_to_refl(x[:, list(MS_IDX)])
+        else:
+            out[:, :3] = s2.rgb_to_refl(x[:, :3])
+            out[:, 3:4] = s2.ms_to_refl(x[:, 3:4])
+    return out[0] if squeeze else out
+
+
+def dev_metrics(pred_model: torch.Tensor, gt_model: torch.Tensor,
+                cfg: dict) -> dict[str, float]:
+    from geocr.metrics import lineages as LIN
+    p = to_dump_domain(pred_model, cfg)
+    g = to_dump_domain(gt_model, cfg)
+    if p.dim() == 3:
+        p, g = p[None], g[None]
+    lin = cfg["lineage"]
+    if lin in ("tcloud", "cuhk", "cuhk_rgb"):
+        p, g = p.detach().cpu(), g.detach().cpu()
+
+    def one(pi, gi):
+        pi, gi = pi[None], gi[None]
+        if lin == "masked13":
+            from geocr.metrics.masked import masked_ergas, masked_metrics
+            from geocr.normalize import S2_BANDS
+            nb10 = [i for i, b in enumerate(S2_BANDS) if b != "B10"]
+            m = torch.ones(1, 1, *pi.shape[-2:], device=pi.device, dtype=pi.dtype)
+            out = masked_metrics(pi.clamp(0, 1), gi.clamp(0, 1), m)
+            out["ergas_no_b10"] = masked_ergas(pi[:, nb10].clamp(0, 1),
+                                               gi[:, nb10].clamp(0, 1), m)
+            return out
+        if lin == "sen2mtc":
+            from geocr.metrics.sen2mtc import sen2mtc_metrics
+            return sen2mtc_metrics(pi[:, :3], gi[:, :3])
+        if lin == "tcloud":
+            return LIN.tcloud_metrics(pi[:, :3], gi[:, :3])
+        if lin == "cuhk":
+            return LIN.cuhk_metrics(pi[:, :4], gi[:, :4])
+        if lin == "cuhk_rgb":
+            r = LIN._batched(LIN._cuhk_one, pi[:, :3], gi[:, :3], lpips=False)
+            return {k.replace("cuhk_", "cuhkrgb_"): v for k, v in r.items()}
+        raise SystemExit(f"unknown lineage {lin!r}")
+
+    tot: dict[str, float] = {}
+    for i in range(p.shape[0]):
+        for k, v in one(p[i], g[i]).items():
+            tot[k] = tot.get(k, 0.0) + float(v)
+    return {k: v / p.shape[0] for k, v in tot.items()}
