@@ -0,0 +1,215 @@
+#!/usr/bin/env python
+"""Write GACR predictions (keyed per-sample noise) as CHW .npy files plus a manifest."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+from tqdm.auto import tqdm
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+from engine import OARFlowEngine
+from geocr_data import (
+    GeoCRSplitDataset, corpus_cfg, sample_noise, sid_flat, split_sha256,
+    to_dump_domain,
+)
+from models.k_diffusion import image_transformer
+from test import dict_to_namespace, namespace_to_dict, strip_prefix
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def code_rev() -> str:
+    try:
+        return subprocess.run(["git", "-C", str(HERE), "rev-parse", "--short", "HEAD"],
+                              capture_output=True, text=True, timeout=10).stdout.strip()
+    except Exception:
+        return "unknown"
+
+
+CODE_PATCHES = [
+    "dataset.py: val branch",
+    "train.py: dataset.kind dispatch, GCPA native resolution, global batch with "
+    "gradient accumulation, dev evaluation, dataset.train_split, logging.dev_select, --set",
+    "engine.py: token-count guard, injectable sampling noise",
+    "test.py: no val_size truncation of the test set, --set",
+    "models/sgm/evaluator.py: lazy lpips, resolution-free 4-band branch",
+    "models/k_diffusion/{layers,image_transformer}.py: optional dctorch, natten has_fused_na fallback",
+    "new: geocr_data.py dump.py vfm_hub/hubconf.py",
+]
+
+
+def build_model(config, device):
+    model = image_transformer.ImageTransformerDenoiserModelInterface(
+        **namespace_to_dict(config.model)).to(device)
+    model.eval()
+    return model
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="Write GACR predictions in the dump contract format.")
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--set", action="append", default=[], metavar="KEY=VALUE")
+    ap.add_argument("--ckpt", required=True)
+    ap.add_argument("--state-key", default=None, choices=["ema", "model", "raw"],
+                    help="default: infer from the checkpoint (best_*.pt carry one key)")
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--out", required=True, help="dumps/<corpus>/<split>/gacr/<run_id>")
+    ap.add_argument("--num-steps", type=int, default=None,
+                    help="Euler NFE; default = misc.eval_num_steps from the config")
+    ap.add_argument("--batch-size", type=int, default=8,
+                    help="throughput only; noise is keyed per sample")
+    ap.add_argument("--fp16", action="store_true",
+                    help="float16 output (only for splits of >= 5000 items)")
+    ap.add_argument("--device", default=None)
+    ap.add_argument("--limit", type=int, default=None,
+                    help="predict only the first N items (testing)")
+    ap.add_argument("--train-report", default=None,
+                    help="exps/<exp>/train_report.json; defaults to the one next "
+                         "to --ckpt")
+    a = ap.parse_args()
+
+    from test import apply_overrides_ns, load_config
+    config = apply_overrides_ns(load_config(a.config), a.set)
+    if getattr(config.dataset, "kind", None) != "geocr":
+        raise SystemExit("dump.py requires dataset.kind: geocr")
+    device = torch.device(a.device or ("cuda" if torch.cuda.is_available() else "cpu"))
+    ccfg = corpus_cfg(config.dataset.corpus)
+    nfe = a.num_steps or int(getattr(config.misc, "eval_num_steps", 4))
+    seed = int(config.misc.seed)
+
+    ds = GeoCRSplitDataset(
+        corpus=config.dataset.corpus, split=a.split,
+        splits_dir=getattr(config.dataset, "splits_dir", "splits"),
+        root=getattr(config.dataset, "root", None) or None,
+        cond_frames=getattr(config.dataset, "cond_frames", None),
+        anchor_frame=getattr(config.dataset, "anchor_frame", 0),
+        rgb_view=getattr(config.gcpa, "rgb_view", "model_norm"),
+        max_items=a.limit)
+    if a.fp16 and len(ds.ids) < 5000 and a.limit is None:
+        raise SystemExit(f"--fp16 is permitted only for splits >= 5000 items; "
+                         f"{ccfg['name']}/{a.split} has {len(ds.ids)}")
+
+    ckpt_path = Path(a.ckpt)
+    ck = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+    key = a.state_key
+    if key in (None, "raw"):
+        cand = [k for k in ("ema", "model", "raw") if k in ck]
+        if key == "raw":
+            cand = [k for k in ("raw", "model") if k in ck]
+        if not cand:
+            raise SystemExit(f"{ckpt_path}: no weight key among {list(ck)}")
+        key = cand[0]
+    if key not in ck:
+        raise SystemExit(f"{ckpt_path} has no key {key!r}; has {list(ck)}")
+    model = build_model(config, device)
+    model.load_state_dict(strip_prefix(ck[key]), strict=True)
+
+    engine = OARFlowEngine(model=model, prediction=config.loss.prediction,
+                           path_type=config.loss.path_type,
+                           weighting=config.loss.weighting,
+                           p=getattr(config.loss, "p", 3.0))
+
+    out = Path(a.out)
+    preds = out / "preds"
+    preds.mkdir(parents=True, exist_ok=True)
+    loader = DataLoader(ds, batch_size=a.batch_size, shuffle=False,
+                        num_workers=int(config.misc.num_workers), pin_memory=True)
+
+    t0 = time.time()
+    written: list[str] = []
+    torch.set_grad_enabled(False)
+    for b in tqdm(loader, desc=f"dump {ccfg['name']}/{a.split}"):
+        mu = b["cloudy"].to(device)
+        cond = b["cond"].to(device)
+        noise = torch.stack([sample_noise(s, tuple(mu.shape[1:]), seed)
+                             for s in b["sid"]]).to(device)
+        samples, _ = engine.sample(cond, mu, uc=cond, batch_size=mu.shape[0],
+                                   shape=mu.shape[1:], num_steps=nfe, noise=noise)
+        dom = to_dump_domain(samples.float().cpu(), ccfg).numpy()
+        for i, sid in enumerate(b["sid"]):
+            arr = dom[i].astype(np.float16 if a.fp16 else np.float32)
+            stem = Path(sid_flat(sid)).stem
+            np.save(preds / f"{stem}.npy", arr)
+            written.append(stem)
+
+    want = {Path(sid_flat(s)).stem for s in ds.ids}
+    have = {p.stem for p in preds.glob("*.npy")}
+    if a.limit is None and have != want:
+        raise SystemExit(
+            f"dump key set != split list: {len(have)} files vs {len(want)} ids "
+            f"(missing {sorted(want - have)[:5]}, extra {sorted(have - want)[:5]})")
+
+    tr = Path(a.train_report) if a.train_report else ckpt_path.parent.parent / "train_report.json"
+    report = json.loads(tr.read_text()) if tr.is_file() else {}
+    if not report:
+        print(f"note: no train_report.json at {tr}; training facts are not copied into the manifest")
+
+    man = {
+        "corpus": ccfg["name"], "split": a.split,
+        "split_list": str(Path(ds.root) / ds.splits_dir / f"{a.split}.txt"),
+        "split_list_sha256": split_sha256(ds.root, a.split, ds.splits_dir),
+        "n_items": len(ds.ids),
+        "resolution": [ccfg["res"], ccfg["res"]],
+        "crop": "none",
+        "bands": ccfg["bands"],
+        "domain": ccfg["domain"],
+        "processing_level": ccfg["level"],
+        "native_resolution": [ccfg["native"], ccfg["native"]],
+        "resample": ({"op": "PIL.BICUBIC(geocr.data.benchmarks._resize_u8)",
+                      "where": "gacr_loader", "stage": "pre-inference"}
+                     if ccfg["native"] != ccfg["res"] else
+                     {"op": "none", "where": "n/a", "stage": "n/a"}),
+        "dtype": "float16" if a.fp16 else "float32",
+        "method": "gacr", "method_variant": Path(a.config).name,
+        "code_rev": code_rev(), "code_patches": CODE_PATCHES,
+        "ckpt": str(ckpt_path), "ckpt_sha256": sha256_file(ckpt_path),
+        "ckpt_state_key": key,
+        "ckpt_selection": report.get("ckpt_selection", "final"),
+        "seed": seed,
+        "sampler": {"type": "euler_oar", "nfe": nfe,
+                    "prior": f"x1 = eps + rho*x_cond, rho={getattr(config.loss,'p',3.0)}",
+                    "grid": "unshifted uniform t: 1 -> 0",
+                    "noise_keying": "blake2b(seed:sid) per sample"},
+        "frames_used": ds.k,
+        "frame_rule": ("n/a" if ccfg["k"] == 1 else
+                       f"anchor = frame index {ds.anchor}; cond = concat of "
+                       f"{ds.k} frames in file order"),
+        "sar_used": False,
+        "sar_fill": "n/a",
+        "gcpa_rgb_view": getattr(config.gcpa, "rgb_view", "model_norm"),
+        "batch_size_inference": a.batch_size,
+        "dump_wall_clock_h": round((time.time() - t0) / 3600.0, 4),
+        "gpu": torch.cuda.get_device_name(0) if torch.cuda.is_available() else "cpu",
+        "created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+    }
+    man.update({k: v for k, v in report.items()
+                if k not in ("corpus", "seed", "ckpt_selection")})
+    if a.limit is not None:
+        man["incomplete"] = f"only the first {a.limit} items were predicted"
+    (out / "manifest.json").write_text(json.dumps(man, indent=2, sort_keys=True) + "\n")
+
+    print(f"\nwrote {len(written)} predictions -> {preds}")
+    print(f"manifest -> {out / 'manifest.json'}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
