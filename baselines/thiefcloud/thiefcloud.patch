+++ b/ThiefCloud/geocr_data.py
@@ -0,0 +1,224 @@
+"""Split-list data sources for ThiefCloud (T-CLOUD, CUHK-CR, Sen2_MTC_New frame 0)."""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+_WORK = Path(__file__).resolve().parents[2]
+CR_DATASETS = Path(os.environ.get("CR_DATASETS", _WORK / "CR_datasets"))
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", _WORK / "GeoCR"))
+BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+
+
+def _shared():
+    p = str(BASELINES / "exporters")
+    for q in (p, str(GEOCR_ROOT)):
+        if q not in sys.path:
+            sys.path.insert(0, q)
+    try:
+        import _common
+    except Exception as exc:
+        raise SystemExit(
+            f"cannot import exporters/_common.py from {p}: {exc}; set GEOCR_BASELINES") from exc
+    return _common
+
+
+def _geocr():
+    if str(GEOCR_ROOT) not in sys.path:
+        sys.path.insert(0, str(GEOCR_ROOT))
+    from geocr.data.benchmarks import _read_png, _read_tif, _resize_u8
+    return dict(read_png=_read_png, read_tif=_read_tif, resize_u8=_resize_u8)
+
+
+def sid_flat(sid: str) -> str:
+    return _shared().sid_flat(sid)
+
+
+def dump_key(sid: str) -> str:
+    return Path(sid_flat(sid)).stem
+
+
+def read_split(root: Path, split: str, splits_dir: str = "splits") -> list[str]:
+    return _shared().read_split(Path(root), split, splits_dir)
+
+
+CORPORA: dict[str, dict] = {
+    "tcloud": dict(
+        root=CR_DATASETS / "T-CLOUD", kind="display8", native=256, res=256,
+        clear_sub=[("/cloud/", "/reference/"), ("/cloud/", "/label/")],
+        lineage="tcloud", dev_key="tcloud_psnr", bands=["R", "G", "B"],
+        level="display8", domain="unit_float", dump_dir="tcloud",
+    ),
+    "cuhk_cr1": dict(
+        root=CR_DATASETS / "C-CUHK" / "CUHK-CR1", kind="display8", native=512, res=256,
+        clear_sub=[("/cloud/", "/label/")],
+        lineage="cuhk_rgb", dev_key="cuhkrgb_psnr", bands=["R", "G", "B"],
+        level="display8", domain="unit_float", dump_dir="cuhk_cr",
+    ),
+    "cuhk_cr2": dict(
+        root=CR_DATASETS / "C-CUHK" / "CUHK-CR2", kind="display8", native=512, res=256,
+        clear_sub=[("/cloud/", "/label/")],
+        lineage="cuhk_rgb", dev_key="cuhkrgb_psnr", bands=["R", "G", "B"],
+        level="display8", domain="unit_float", dump_dir="cuhk_cr2",
+    ),
+    "sen2mtc_new": dict(
+        root=CR_DATASETS / "Sen2_MTC_New", kind="sen2mtc", native=256, res=256,
+        clear_sub=None,
+        lineage="sen2mtc", dev_key="mtc_psnr", bands=["R", "G", "B", "NIR"],
+        level="boa", domain="reflectance", dump_dir="sen2mtc_new",
+        mtc_dn_ceiling=2000.0,
+    ),
+}
+
+ALIASES = {"cuhk_cr": "cuhk_cr1"}
+
+
+def resolve(corpus: str) -> str:
+    c = ALIASES.get(corpus, corpus)
+    if c not in CORPORA:
+        raise SystemExit(f"unknown corpus {corpus!r}; have {list(CORPORA)} "
+                         f"(aliases {ALIASES})")
+    return c
+
+
+def clear_id(sid: str, cfg: dict, root: Path) -> str:
+    for needle, repl in cfg["clear_sub"]:
+        if needle in sid:
+            cand = sid.replace(needle, repl)
+            if (root / cand).is_file():
+                return cand
+    raise SystemExit(f"no clear counterpart on disk for {sid} under {root}")
+
+
+def _u8_to_chw01(arr: np.ndarray) -> torch.Tensor:
+    if arr.ndim == 2:
+        arr = np.repeat(arr[..., None], 3, axis=-1)
+    arr = arr[..., :3]
+    return torch.from_numpy(np.ascontiguousarray(
+        arr.transpose(2, 0, 1).astype(np.float32) / 255.0))
+
+
+class Display8Source:
+
+    def __init__(self, corpus: str, split: str, cfg: dict, root: Path,
+                 export_root: Path | None, source: str = "auto"):
+        self.cfg, self.root, self.corpus, self.split = cfg, root, corpus, split
+        self.g = _geocr()
+        self.res = int(cfg["res"])
+        exp = None
+        if export_root is not None:
+            cand = Path(export_root) / corpus / split
+            if (cand / "list.txt").is_file():
+                exp = cand
+        if source == "export" and exp is None:
+            raise SystemExit(
+                f"source=export but no export at {export_root}/{corpus}/{split}. "
+                f"Run exporters/export_display8.py, or pass source=native.")
+        self.export = exp if source in ("auto", "export") else None
+        self.where = "exporter" if self.export is not None else "loader"
+
+    def pair(self, sid: str) -> tuple[torch.Tensor, torch.Tensor]:
+        if self.export is not None:
+            stem = dump_key(sid) + ".png"
+            c = self.g["read_png"](self.export / "cloudy" / stem)
+            t = self.g["read_png"](self.export / "clear" / stem)
+        else:
+            c = self.g["resize_u8"](self.g["read_png"](self.root / sid), self.res)
+            cid = clear_id(sid, self.cfg, self.root)
+            t = self.g["resize_u8"](self.g["read_png"](self.root / cid), self.res)
+        return _u8_to_chw01(c), _u8_to_chw01(t)
+
+
+class Sen2MTCSource:
+
+    def __init__(self, corpus: str, split: str, cfg: dict, root: Path,
+                 frame_index: int = 0):
+        self.cfg, self.root, self.frame = cfg, root, int(frame_index)
+        self.ceil = float(cfg["mtc_dn_ceiling"])
+        self.g = _geocr()
+
+    def cloudy_path(self, sid: str) -> Path:
+        t = self.root / sid
+        return t.parent.parent / "cloud" / f"{t.stem}_{self.frame}.tif"
+
+    def _rgb01(self, p: Path) -> torch.Tensor:
+        arr = self.g["read_tif"](p)
+        v = arr[:3].astype(np.float32)
+        return torch.from_numpy(np.ascontiguousarray(
+            np.clip(v, 0.0, self.ceil) / self.ceil))
+
+    def pair(self, sid: str) -> tuple[torch.Tensor, torch.Tensor]:
+        cp = self.cloudy_path(sid)
+        if not cp.is_file():
+            raise FileNotFoundError(f"{cp}: expected cloud frame {self.frame}")
+        return self._rgb01(cp), self._rgb01(self.root / sid)
+
+
+def make_source(corpus: str, split: str, cfg: dict, root: Path,
+                export_root: Path | None, source: str, frame_index: int):
+    if cfg["kind"] == "display8":
+        return Display8Source(corpus, split, cfg, root, export_root, source)
+    return Sen2MTCSource(corpus, split, cfg, root, frame_index)
+
+
+class SplitPairs(Dataset):
+
+    def __init__(self, src, ids: list[str], mode: str, patch_size: int = 256):
+        assert mode in ("train", "eval")
+        self.src, self.ids, self.mode, self.ps = src, list(ids), mode, int(patch_size)
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def __getitem__(self, index: int):
+        sid = self.ids[index % len(self.ids)]
+        input_, target = self.src.pair(sid)
+        if self.mode == "eval":
+            return input_, target, sid
+
+        import random
+        ps = self.ps
+        hh, ww = target.shape[1], target.shape[2]
+        rr = random.randint(0, hh - ps)
+        cc = random.randint(0, ww - ps)
+        aug = random.randint(0, 8)
+        input_ = input_[:, rr:rr + ps, cc:cc + ps]
+        target = target[:, rr:rr + ps, cc:cc + ps]
+        if aug == 1:
+            input_, target = input_.flip(1), target.flip(1)
+        elif aug == 2:
+            input_, target = input_.flip(2), target.flip(2)
+        elif aug == 3:
+            input_, target = torch.rot90(input_, dims=(1, 2)), torch.rot90(target, dims=(1, 2))
+        elif aug == 4:
+            input_, target = torch.rot90(input_, dims=(1, 2), k=2), torch.rot90(target, dims=(1, 2), k=2)
+        elif aug == 5:
+            input_, target = torch.rot90(input_, dims=(1, 2), k=3), torch.rot90(target, dims=(1, 2), k=3)
+        elif aug == 6:
+            input_, target = torch.rot90(input_.flip(1), dims=(1, 2)), torch.rot90(target.flip(1), dims=(1, 2))
+        elif aug == 7:
+            input_, target = torch.rot90(input_.flip(2), dims=(1, 2)), torch.rot90(target.flip(2), dims=(1, 2))
+        return input_, target
+
+
+def dev_metric(corpus: str, pred01, gt01) -> dict[str, float]:
+    if str(GEOCR_ROOT) not in sys.path:
+        sys.path.insert(0, str(GEOCR_ROOT))
+    from geocr.metrics import lineages as LIN
+    cfg = CORPORA[resolve(corpus)]
+    lin = cfg["lineage"]
+    if lin == "tcloud":
+        return LIN.tcloud_metrics(pred01[:, :3], gt01[:, :3])
+    if lin == "cuhk_rgb":
+        r = LIN._batched(LIN._cuhk_one, pred01[:, :3], gt01[:, :3], lpips=False)
+        return {k.replace("cuhk_", "cuhkrgb_"): v for k, v in r.items()}
+    if lin == "sen2mtc":
+        from geocr.metrics.sen2mtc import sen2mtc_metrics
+        s = cfg["mtc_dn_ceiling"] / 10000.0
+        return sen2mtc_metrics(pred01[:, :3] * s, gt01[:, :3] * s)
+    raise SystemExit(f"no dev metric for lineage {lin!r}")
diff --git a/ThiefCloud/geocr_dump.py b/ThiefCloud/geocr_dump.py
new file mode 100644
index 0000000..9b4c1c7
--- /dev/null
+++ b/ThiefCloud/geocr_dump.py
@@ -0,0 +1,212 @@
+"""Write ThiefCloud predictions as CHW .npy files plus a manifest."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from torch.utils.data import DataLoader
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import geocr_data as G
+from geocr_train import load_config, pick_device, seed_everything
+from model import ThiefCloud
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def code_rev(repo: Path) -> str:
+    try:
+        return subprocess.check_output(
+            ["git", "-C", str(repo), "rev-parse", "--short", "HEAD"],
+            text=True, stderr=subprocess.DEVNULL).strip()
+    except Exception:
+        return "unknown"
+
+
+CODE_PATCHES = [
+    "model.py: SCPM checkpoint path from the repository (or THIEFCLOUD_SCPM_CKPT); torch.load map_location/weights_only",
+    "train.py, SCPM/src/{train_cd,test_cd}.py: no in-process CUDA_VISIBLE_DEVICES",
+    "train.py: --val_data and --pre_state defaults",
+    "test.py, demo.py: model class import",
+    "new: geocr_data.py geocr_train.py geocr_dump.py",
+]
+
+
+@torch.no_grad()
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--ckpt", required=True,
+                    help="final.pth written by geocr_train.py")
+    ap.add_argument("--run-meta", default=None, help="run_meta.json from the same run")
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--dumps", default=None, help="dump root (default from config)")
+    ap.add_argument("--run-id", default=None,
+                    help="default YYYYMMDD_<config-sha8>_seed<N>")
+    ap.add_argument("--batch-size", type=int, default=1)
+    ap.add_argument("--limit", type=int, default=0,
+                    help="predict only the first N ids (testing)")
+    ap.add_argument("--preview", action="store_true",
+                    help="also write uint8 PNG previews")
+    ap.add_argument("overrides", nargs="*", default=[])
+    args = ap.parse_args()
+
+    cfg = load_config(args.config, args.overrides)
+    corpus = G.resolve(cfg["corpus"])
+    ccfg = G.CORPORA[corpus]
+    repo = Path(__file__).resolve().parent.parent
+
+    root = Path(cfg["root"]) if cfg.get("root") else ccfg["root"]
+    export_root = Path(cfg["export_root"]) if cfg.get("export_root") else None
+    ids = G.read_split(root, args.split, cfg["splits_dir"])
+    split_list = root / cfg["splits_dir"] / f"{args.split}.txt"
+    train_split_p = root / cfg["splits_dir"] / f"{cfg['train_split']}.txt"
+    if args.limit:
+        ids = ids[:args.limit]
+
+    seed_everything(int(cfg["seed"]))
+    device = pick_device(cfg)
+    model = ThiefCloud(swich=True).to(device)
+    model.load_state_dict(torch.load(args.ckpt, map_location=device,
+                                     weights_only=True))
+    model.eval()
+
+    src = G.make_source(corpus, args.split, ccfg, root, export_root,
+                        cfg["source"], int(cfg["frame_index"]))
+    ds = G.SplitPairs(src, ids, "eval")
+    loader = DataLoader(ds, batch_size=args.batch_size, shuffle=False,
+                        drop_last=False, num_workers=int(cfg["num_works"]),
+                        pin_memory=True)
+
+    dumps = Path(args.dumps) if args.dumps else Path(cfg["dump_root"])
+    run_id = args.run_id or (
+        f"{time.strftime('%Y%m%d')}_"
+        f"{hashlib.sha256(Path(args.config).read_bytes()).hexdigest()[:8]}_"
+        f"seed{int(cfg['seed'])}")
+    out = dumps / ccfg["dump_dir"] / args.split / "thiefcloud" / run_id
+    (out / "preds").mkdir(parents=True, exist_ok=True)
+    if args.preview:
+        (out / "preview").mkdir(parents=True, exist_ok=True)
+
+    is_mtc = ccfg["kind"] == "sen2mtc"
+    scale = (ccfg["mtc_dn_ceiling"] / 10000.0) if is_mtc else 1.0
+    n_out = len(ccfg["bands"])
+
+    t0 = time.time()
+    written = []
+    for x, _y, sids in loader:
+        x = x.to(device, non_blocking=True)
+        h, w = x.shape[-2:]
+        if h % 8 or w % 8:
+            raise SystemExit(f"{sids[0]}: {h}x{w} is not divisible by 8 "
+                             f"(SCPM has three AvgPool2d(2), cd_model.py:482-488)")
+        out_b = model(x, only_last=True).float().clamp(0, 1).cpu().numpy()
+        for i, sid in enumerate(sids):
+            a = out_b[i] * scale
+            if is_mtc:
+                full = np.full((n_out, *a.shape[1:]), np.nan, dtype=np.float32)
+                full[:3] = a
+                a = full
+            key = G.dump_key(sid)
+            np.save(out / "preds" / f"{key}.npy", np.ascontiguousarray(a, dtype=np.float32))
+            written.append(key)
+            if args.preview:
+                from PIL import Image
+                u8 = np.clip(out_b[i][:3] * 255.0, 0, 255).astype(np.uint8)
+                Image.fromarray(u8.transpose(1, 2, 0)).save(
+                    out / "preview" / f"{key}.png")
+
+    expect = [G.dump_key(s) for s in ids]
+    if sorted(written) != sorted(expect):
+        raise SystemExit(f"{out}: wrote {len(written)} keys, split list has "
+                         f"{len(expect)} -- refusing to leave a dump whose key "
+                         f"set is not equal to the split list.")
+    if args.limit:
+        print(f"WARNING: --limit {args.limit} was used; this dump is a subset.", flush=True)
+
+    meta = {}
+    if args.run_meta and Path(args.run_meta).is_file():
+        meta = json.loads(Path(args.run_meta).read_text())
+
+    manifest = {
+        "corpus": corpus, "split": args.split,
+        "split_list": str(split_list),
+        "split_list_sha256": sha256_file(split_list),
+        "n_items": len(expect),
+        "resolution": [ccfg["res"], ccfg["res"]],
+        "crop": "none",
+        "bands": list(ccfg["bands"]),
+        "domain": ccfg["domain"],
+        "processing_level": ccfg["level"],
+        "native_resolution": [ccfg["native"], ccfg["native"]],
+        "resample": ({"op": "PIL.BICUBIC", "where": getattr(src, "where", "loader"),
+                      "stage": "pre-inference"}
+                     if ccfg["native"] != ccfg["res"] else
+                     {"op": "none", "where": "n/a", "stage": "n/a"}),
+        "dtype": "float32",
+        "bands_predicted": ["R", "G", "B"],
+        "nir_plane": ("NaN (not predicted)" if is_mtc else None),
+        "method": "thiefcloud", "method_variant": Path(args.config).name,
+        "run_id": run_id,
+        "code_rev": code_rev(repo), "code_patches": CODE_PATCHES,
+        "ckpt": str(Path(args.ckpt).resolve()),
+        "ckpt_sha256": sha256_file(Path(args.ckpt)),
+        "scpm_ckpt": os.environ.get("THIEFCLOUD_SCPM_CKPT") or str(
+            repo / "SCPM" / "checkpointsCDNet_V1" / "best_CDNet_V1_SateHaze1k.pth"),
+        "scpm_ckpt_sha256": sha256_file(Path(
+            os.environ.get("THIEFCLOUD_SCPM_CKPT") or
+            repo / "SCPM" / "checkpointsCDNet_V1" / "best_CDNet_V1_SateHaze1k.pth")),
+        "ckpt_selection": meta.get("ckpt_selection", cfg["ckpt_selection"]),
+        "ema": meta.get("ema", False),
+        "train_split": str(train_split_p),
+        "train_split_sha256": sha256_file(train_split_p),
+        "dev_split_sha256": (None if cfg["ckpt_selection"] == "final"
+                             else sha256_file(root / cfg["splits_dir"] / "val.txt")),
+        "n_train": meta.get("n_train"),
+        "seed": int(meta.get("seed", cfg["seed"])),
+        "sampler": {"type": "deterministic_feedforward", "nfe": 1},
+        "frames_used": 1,
+        "frame_rule": ("frame index 0" if is_mtc else "n/a"),
+        "sar_used": False, "sar_fill": "n/a",
+        "postprocess": ("clamp[0,1] in the model domain then x%.4f -> reflectance"
+                        % scale) if is_mtc else "clamp[0,1]",
+        "input_map": ("DN clipped to [0,%g] / %g"
+                      % (ccfg["mtc_dn_ceiling"], ccfg["mtc_dn_ceiling"]))
+                     if is_mtc else "png/255",
+        "steps_used": meta.get("steps_used"), "epochs_used": meta.get("epochs_used"),
+        "ceiling_hit": meta.get("ceiling_hit"),
+        "early_stopped": meta.get("early_stopped"),
+        "dev_metric": meta.get("dev_metric"), "dev_best": meta.get("dev_best"),
+        "dev_evaluations_consumed": meta.get("dev_evaluations_consumed"),
+        "dev_slope_last10": meta.get("dev_slope_last10"),
+        "batch_global": meta.get("batch_global"), "microbatch": meta.get("microbatch"),
+        "grad_accum": meta.get("grad_accum"), "lr": meta.get("lr"),
+        "lr_point": meta.get("lr_point"),
+        "wall_clock_h": meta.get("wall_clock_h"),
+        "gpu": meta.get("gpu", "cpu"),
+        "params_trainable": meta.get("params_trainable"),
+        "params_total": meta.get("params_total"),
+        "inference_wall_h": round((time.time() - t0) / 3600.0, 5),
+        "subset": bool(args.limit),
+    }
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(f"[thiefcloud] wrote {len(written)} preds to {out}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
