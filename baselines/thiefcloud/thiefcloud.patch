@@ -0,0 +1,335 @@
+"""Two-stage ThiefCloud training on a split list for a fixed number of optimizer steps."""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import random
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.backends.cudnn as cudnn
+import torch.nn.functional as F
+import torch.optim as optim
+import yaml
+from torch.cuda.amp import GradScaler, autocast
+from torch.utils.data import DataLoader
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import geocr_data as G
+from model import ThiefCloud
+from perceptual import LossNetwork
+
+
+def load_config(path: str, overrides: list[str]) -> dict:
+    cfg = yaml.safe_load(Path(path).read_text())
+    for kv in overrides:
+        if "=" not in kv:
+            raise SystemExit(f"override {kv!r} is not key=value")
+        k, v = kv.split("=", 1)
+        if k not in cfg:
+            raise SystemExit(f"unknown config key {k!r}; have {sorted(cfg)}")
+        cfg[k] = yaml.safe_load(v)
+    return cfg
+
+
+def seed_everything(seed: int) -> None:
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+
+
+def pick_device(cfg: dict) -> torch.device:
+    if cfg.get("device"):
+        return torch.device(cfg["device"])
+    return torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+
+@torch.no_grad()
+def evaluate(model, loader, corpus: str, device, key: str) -> float:
+    model.eval()
+    vals = []
+    for x, y, _ in loader:
+        x = x.to(device, non_blocking=True)
+        out = model(x, only_last=True).float().clamp(0, 1).cpu()
+        for i in range(out.shape[0]):
+            vals.append(G.dev_metric(corpus, out[i:i + 1], y[i:i + 1])[key])
+    model.train()
+    return float(sum(vals) / len(vals))
+
+
+def run_stage(stage: int, cfg: dict, model, train_loader, dev_loader, device,
+              lr: float, steps: int, state: dict) -> None:
+    corpus, key = state["corpus"], state["dev_key"]
+    optimizer = optim.Adam(model.parameters(), lr=lr)
+    scheduler = optim.lr_scheduler.CosineAnnealingLR(
+        optimizer, T_max=max(steps, 1), eta_min=float(cfg["lr_min"]))
+    scaler = GradScaler(enabled=bool(cfg["autocast"]) and device.type == "cuda")
+    loss_network = state["loss_network"]
+    w = float(cfg["loss_weight1"])
+    eval_every = int(state["eval_every"])
+    select = state["ckpt_selection"]
+    patience = int(cfg["patience_evals"]) if select == "best_on_dev" else None
+
+    model.train()
+    since_improved, step = 0, 0
+    it = iter(train_loader)
+    t0 = time.time()
+    while step < steps:
+        try:
+            x, y = next(it)
+        except StopIteration:
+            it = iter(train_loader)
+            state["epochs"] += 1
+            x, y = next(it)
+
+        x = x.to(device, non_blocking=True)
+        y = y.to(device, non_blocking=True)
+
+        model.zero_grad()
+        optimizer.zero_grad()
+        with autocast(enabled=bool(cfg["autocast"]) and device.type == "cuda"):
+            restored, fake_x4, fake_x2 = model(x, only_last=False)
+            loss_2 = (2.4 * F.mse_loss(restored, y)
+                      + 0.3 * F.mse_loss(fake_x4, y)
+                      + 0.3 * F.mse_loss(fake_x2, y))
+            fake_x4 = fake_x4.to(dtype=torch.float32)
+            fake_x2 = fake_x2.to(dtype=torch.float32)
+            loss_perceptual = (loss_network(restored, y)
+                               + loss_network(fake_x4, y)
+                               + loss_network(fake_x2, y))
+            loss = loss_2 + w * loss_perceptual
+        optimizer.zero_grad()
+        scaler.scale(loss).backward()
+        scaler.step(optimizer)
+        scaler.update()
+
+        scheduler.step()
+        step += 1
+        state["steps"] += 1
+
+        if step % eval_every == 0 or step == steps:
+            if select == "final":
+                rec = {"stage": stage, "stage_step": step,
+                       "global_step": state["steps"],
+                       "lr": scheduler.get_last_lr()[0],
+                       "loss": float(loss.detach().float().item())}
+                state["train_history"].append(rec)
+                print(f"[stage {stage}] step {step}/{steps} "
+                      f"(global {state['steps']}) loss={rec['loss']:.5f} "
+                      f"lr={rec['lr']:.3g}", flush=True)
+                (state["out"] / "train_history.jsonl").write_text(
+                    "".join(json.dumps(r) + "\n" for r in state["train_history"]))
+            else:
+                v = evaluate(model, dev_loader, corpus, device, key)
+                state["dev_history"].append(
+                    {"stage": stage, "stage_step": step, "global_step": state["steps"],
+                     "lr": scheduler.get_last_lr()[0], key: v,
+                     "loss": float(loss.detach().float().item())})
+                improved = v > state["best"]
+                print(f"[stage {stage}] step {step}/{steps} (global {state['steps']}) "
+                      f"{key}={v:.4f} best={max(v, state['best']):.4f} "
+                      f"{'*' if improved else ''}", flush=True)
+                if improved:
+                    state["best"] = v
+                    state["best_stage"] = stage
+                    state["best_step"] = state["steps"]
+                    torch.save(model.state_dict(), state["out"] / "best.pth")
+                    since_improved = 0
+                else:
+                    since_improved += 1
+                if v > state["stage_best"]:
+                    state["stage_best"] = v
+                    torch.save(model.state_dict(), state["out"] / f"stage{stage}_best.pth")
+                (state["out"] / "dev_history.jsonl").write_text(
+                    "".join(json.dumps(r) + "\n" for r in state["dev_history"]))
+                if since_improved >= patience:
+                    print(f"[stage {stage}] early stop: {patience} evals without "
+                          f"improvement", flush=True)
+                    state["early_stopped"] = True
+                    break
+            if (time.time() - state["t_start"]) / 3600.0 > float(cfg["max_hours"]):
+                print(f"[stage {stage}] wall-clock ceiling "
+                      f"{cfg['max_hours']} h reached", flush=True)
+                state["wallclock_stop"] = True
+                break
+    state["stage_wall_h"].append((time.time() - t0) / 3600.0)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("overrides", nargs="*", default=[])
+    args = ap.parse_args()
+
+    cfg = load_config(args.config, args.overrides)
+    corpus = G.resolve(cfg["corpus"])
+    ccfg = G.CORPORA[corpus]
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+
+    if int(cfg["grad_accum"]) != 1:
+        raise SystemExit(
+            "grad_accum must be 1: the cloud prior has BatchNorm layers and is "
+            "trained in stage 2, so accumulation is not equivalent to a real batch")
+    if int(cfg["seed"]) not in list(cfg["seeds"]):
+        raise SystemExit(f"seed {cfg['seed']} is not in the configured seeds {cfg['seeds']}")
+    select = str(cfg["ckpt_selection"])
+    if select not in ("final", "best_on_dev"):
+        raise SystemExit(f"ckpt_selection must be 'final' or 'best_on_dev'; got {select!r}")
+    lr1, lr2 = (float(v) for v in cfg["lr_grid"][int(cfg["lr_point"])])
+
+    seed_everything(int(cfg["seed"]))
+    device = pick_device(cfg)
+    cudnn.benchmark = True
+
+    root = Path(cfg["root"]) if cfg.get("root") else ccfg["root"]
+    export_root = Path(cfg["export_root"]) if cfg.get("export_root") else None
+    train_split = str(cfg["train_split"])
+    src_tr = G.make_source(corpus, train_split, ccfg, root, export_root,
+                           cfg["source"], int(cfg["frame_index"]))
+    ids_tr = G.read_split(root, train_split, cfg["splits_dir"])
+    ids_te = G.read_split(root, "test", cfg["splits_dir"])
+    if len(set(ids_tr)) != len(ids_tr):
+        raise SystemExit(f"{train_split}.txt has {len(ids_tr) - len(set(ids_tr))} "
+                         f"duplicate ids -- refusing to run.")
+    if set(ids_tr) & set(ids_te):
+        raise SystemExit(f"{train_split} and test splits overlap -- refusing to "
+                         f"run.")
+
+    ds_tr = G.SplitPairs(src_tr, ids_tr, "train", int(cfg["patch_size_train"]))
+    gen = torch.Generator()
+    gen.manual_seed(int(cfg["seed"]))
+    train_loader = DataLoader(ds_tr, batch_size=int(cfg["batch_size"]), shuffle=True,
+                              drop_last=True, num_workers=int(cfg["num_works"]),
+                              pin_memory=True, generator=gen,
+                              persistent_workers=int(cfg["num_works"]) > 0)
+
+    ids_dv, dev_loader = [], None
+    if select == "best_on_dev":
+        ids_dv = G.read_split(root, "val", cfg["splits_dir"])
+        if set(ids_dv) & set(ids_te):
+            raise SystemExit(f"dev and test splits overlap on "
+                             f"{len(set(ids_dv) & set(ids_te))} ids -- checkpoint "
+                             f"selection would be on test. RULE B6.")
+        src_dv = G.make_source(corpus, "val", ccfg, root, export_root,
+                               cfg["source"], int(cfg["frame_index"]))
+        dev_loader = DataLoader(G.SplitPairs(src_dv, ids_dv, "eval"),
+                                batch_size=int(cfg["dev_batch_size"]),
+                                shuffle=False, drop_last=False,
+                                num_workers=int(cfg["num_works"]), pin_memory=True)
+
+    from torchvision.models import vgg16
+    vgg_model = vgg16(pretrained=True).features[:16]
+    for p in vgg_model.parameters():
+        p.requires_grad = False
+    loss_network = LossNetwork(vgg_model).to(device)
+    loss_network.eval()
+
+    S = int(cfg["steps"])
+    s1 = int(round(S * float(cfg["stage_split"])))
+    s2 = S - s1
+    eval_every = max(1, S // int(cfg["eval_divisor"]))
+
+    state = dict(corpus=corpus, dev_key=ccfg["dev_key"], out=out, best=-1e9,
+                 best_stage=0, best_step=0, stage_best=-1e9, steps=0, epochs=0,
+                 dev_history=[], train_history=[], ckpt_selection=select,
+                 early_stopped=False, wallclock_stop=False,
+                 loss_network=loss_network, eval_every=eval_every,
+                 t_start=time.time(), stage_wall_h=[])
+
+    print(f"[thiefcloud] corpus={corpus} device={device} "
+          f"source={getattr(src_tr, 'where', 'native-tif')} "
+          f"train_split={train_split} n_train={len(ids_tr)} n_dev={len(ids_dv)} "
+          f"steps={S} (stage1 {s1} / stage2 {s2}) batch={cfg['batch_size']} "
+          f"lr1={lr1:g} lr2={lr2:g} seed={cfg['seed']} "
+          f"log_every={eval_every} ckpt_selection={select} "
+          f"patience={cfg['patience_evals'] if select == 'best_on_dev' else 'n/a'}",
+          flush=True)
+
+    model = ThiefCloud().to(device)
+    params_total = sum(p.numel() for p in model.parameters())
+    state["stage_best"] = -1e9
+    run_stage(1, cfg, model, train_loader, dev_loader, device, lr1, s1, state)
+    if select == "final":
+        st1 = out / "stage1_last.pth"
+        torch.save(model.state_dict(), st1)
+    else:
+        st1 = out / "stage1_best.pth"
+        if not st1.is_file():
+            torch.save(model.state_dict(), st1)
+
+    last_model = model
+    if not (state["early_stopped"] and bool(cfg["stop_after_stage1"])):
+        state["early_stopped"] = False
+        state["stage_best"] = -1e9
+        model2 = ThiefCloud(swich=True).to(device)
+        model2.load_state_dict(torch.load(st1, map_location=device,
+                                          weights_only=True))
+        run_stage(2, cfg, model2, train_loader, dev_loader, device, lr2, s2, state)
+        last_model = model2
+
+    ckpt_path = out / ("final.pth" if select == "final" else "best.pth")
+    if select == "final":
+        torch.save(last_model.state_dict(), ckpt_path)
+
+    hist = [h for h in state["dev_history"]]
+    key = ccfg["dev_key"]
+    slope = None
+    if len(hist) >= 2:
+        cut = state["steps"] * 0.9
+        tail = [h for h in hist if h["global_step"] >= cut] or hist[-1:]
+        slope = float(hist[-1][key] - tail[0][key])
+    meta = {
+        "corpus": corpus, "method": "thiefcloud",
+        "method_variant": Path(args.config).name,
+        "seed": int(cfg["seed"]), "lr_point": int(cfg["lr_point"]),
+        "lr": [lr1, lr2], "batch_global": int(cfg["batch_size"]),
+        "microbatch": int(cfg["batch_size"]), "grad_accum": 1,
+        "steps_budget": S, "steps_used": state["steps"],
+        "epochs_used": round(state["steps"] * int(cfg["batch_size"]) / max(len(ids_tr), 1), 2),
+        "ceiling_hit": state["steps"] >= S,
+        "early_stopped": bool(state["early_stopped"]),
+        "wallclock_stop": bool(state["wallclock_stop"]),
+        "dev_metric": key if hist else None,
+        "dev_best": state["best"] if hist else None,
+        "dev_best_stage": state["best_stage"] if hist else None,
+        "dev_best_step": state["best_step"] if hist else None,
+        "dev_evaluations_consumed": len(hist),
+        "dev_slope_last10": slope,
+        "ckpt_selection": ("final" if select == "final"
+                           else "best_on_dev(raw; over both stages)"),
+        "ema": False,
+        "ckpt": ckpt_path.name,
+        "wall_clock_h": round((time.time() - state["t_start"]) / 3600.0, 4),
+        "stage_wall_h": [round(v, 4) for v in state["stage_wall_h"]],
+        "params_total": params_total, "params_trainable": params_total,
+        "gpu": torch.cuda.get_device_name(0) if device.type == "cuda" else "cpu",
+        "n_train": len(ids_tr), "n_dev": len(ids_dv), "n_test": len(ids_te),
+        "splits_dir": cfg["splits_dir"], "train_split": train_split,
+        "source": getattr(src_tr, "where", "native-tif"),
+        "frame_index": int(cfg["frame_index"]) if ccfg["kind"] == "sen2mtc" else None,
+        "config": cfg,
+    }
+    (out / "run_meta.json").write_text(json.dumps(meta, indent=2) + "\n")
+    if select == "final":
+        print(f"[thiefcloud] done. ckpt_selection=final (no dev split, no "
+              f"scored candidate); steps_used={state['steps']}/{S} "
+              f"epochs={meta['epochs_used']}; "
+              f"wrote {ckpt_path} and {out/'run_meta.json'}", flush=True)
+    else:
+        print(f"[thiefcloud] done. best {key}={state['best']:.4f} at global step "
+              f"{state['best_step']} (stage {state['best_stage']}); "
+              f"steps_used={state['steps']} epochs={meta['epochs_used']}; "
+              f"wrote {ckpt_path} and {out/'run_meta.json'}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
