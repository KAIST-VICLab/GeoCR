index 0000000..a0e3056
--- /dev/null
+++ b/data/geocr_dataset.py
@@ -0,0 +1,160 @@
+"""Split-list dataset for DiffCR (T-CLOUD, CUHK-CR1/2, Sen2_MTC_New)."""
+from __future__ import annotations
+
+import hashlib
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.utils.data as data
+
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", Path(__file__).resolve().parents[2] / "GeoCR"))
+
+
+def _geocr():
+    if str(GEOCR_ROOT) not in sys.path:
+        sys.path.insert(0, str(GEOCR_ROOT))
+    try:
+        from geocr.data.benchmarks import _read_png, _read_tif, _resize_u8
+    except Exception as exc:
+        raise SystemExit(
+            f"cannot import geocr.data.benchmarks from {GEOCR_ROOT}: {exc}; set GEOCR_ROOT"
+        ) from exc
+    return _read_png, _read_tif, _resize_u8
+
+
+CORPORA = {
+    "tcloud":      ("display8", [("/cloud/", "/reference/"), ("/cloud/", "/label/")], False),
+    "cuhk_cr1":    ("display8", [("/cloud/", "/label/")], True),
+    "cuhk_cr2":    ("display8", [("/cloud/", "/label/")], False),
+    "sen2mtc_new": ("boa4", [], False),
+}
+ALIASES = {"cuhk_cr": "cuhk_cr1"}
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def dump_stem(sid: str) -> str:
+    return Path(sid_flat(sid)).stem
+
+
+def read_split(root: Path, split: str, splits_dir: str) -> list[str]:
+    p = Path(root) / splits_dir / f"{split}.txt"
+    if not p.is_file():
+        raise SystemExit(f"missing split file {p}")
+    out = [s for s in (ln.split("#", 1)[0].strip()
+                       for ln in p.read_text().splitlines()) if s]
+    if not out:
+        raise SystemExit(f"{p} is empty")
+    return out
+
+
+class GeoCRSplitDataset(data.Dataset):
+
+    def __init__(self, corpus: str, root: str, split: str, splits_dir: str = "splits",
+                 resolution: int = 256, bands: int = 3, augment: bool = False,
+                 nir_root: str | None = None, mode: str | None = None,
+                 limit: int = 0):
+        corpus = ALIASES.get(corpus, corpus)
+        if corpus not in CORPORA:
+            raise SystemExit(f"unknown corpus {corpus!r}; have {sorted(CORPORA)}")
+        split = split or mode
+        self.corpus, self.level = corpus, CORPORA[corpus][0]
+        self.clear_sub, self.has_nir = CORPORA[corpus][1], CORPORA[corpus][2]
+        self.root = Path(root)
+        self.split, self.splits_dir = split, splits_dir
+        self.resolution, self.bands = int(resolution), int(bands)
+        self.augment = bool(augment) and split in ("train", "trainval")
+        if self.bands == 4 and not self.has_nir:
+            raise SystemExit(f"{corpus} has no NIR tree; bands must be 3")
+        self.nir_root = (Path(nir_root) if nir_root else
+                         self.root.parent / "nir" / self.root.name)
+        self.sids = read_split(self.root, split, splits_dir)
+        if limit:
+            print(f"[geocr_dataset] WARNING limit={limit}: using {limit} of "
+                  f"{len(self.sids)} {self.corpus}/{split} ids")
+            self.sids = self.sids[:limit]
+        self.k = 3 if self.level == "boa4" else 1
+        self._read_png, self._read_tif, self._resize_u8 = _geocr()
+        self._calls, self._salt = 0, None
+
+    def _clear_path(self, sid: str) -> Path:
+        if self.level == "boa4":
+            return self.root / sid
+        for needle, repl in self.clear_sub:
+            if needle in sid:
+                cand = self.root / sid.replace(needle, repl)
+                if cand.is_file():
+                    return cand
+        raise FileNotFoundError(f"{self.corpus}: no clear pair for {sid}")
+
+    def _cond_paths(self, sid: str) -> list[Path]:
+        if self.level == "boa4":
+            stem = Path(sid).stem
+            d = self.root / Path(sid).parent.parent / "cloud"
+            return [d / f"{stem}_{i}.tif" for i in range(3)]
+        return [self.root / sid]
+
+    def _canonical(self, path: Path, sid_for_nir: str | None) -> np.ndarray:
+        if self.level == "boa4":
+            arr = self._read_tif(path).astype(np.float32) / 10000.0
+            return arr[:3]
+        rgb = self._resize_u8(self._read_png(path), self.resolution)
+        out = rgb[..., :3].astype(np.float32).transpose(2, 0, 1) / 255.0
+        if self.bands == 4:
+            nir = self._read_png(self.nir_root / sid_for_nir)
+            nir = self._resize_u8(nir[..., 0] if nir.ndim == 3 else nir,
+                                  self.resolution).astype(np.float32) / 255.0
+            out = np.concatenate([out, nir[None]], axis=0)
+        return out
+
+    def _aug_params(self, sid: str) -> tuple[int, int]:
+        if self._salt is None:
+            self._salt = torch.initial_seed() & 0xFFFFFFFF
+        h = hashlib.blake2b(f"{self._salt}|{self._calls}|{sid}".encode(),
+                            digest_size=8).digest()
+        self._calls += 1
+        r = np.random.default_rng(int.from_bytes(h, "big"))
+        return int(r.integers(0, 3)), int(r.integers(0, 4))
+
+    @staticmethod
+    def _apply_aug(a: np.ndarray, flip: int, rot: int) -> np.ndarray:
+        if flip:
+            a = np.flip(a, flip)
+        if rot:
+            a = np.rot90(a, rot, (1, 2))
+        return np.ascontiguousarray(a)
+
+    def __len__(self) -> int:
+        return len(self.sids)
+
+    def __getitem__(self, index: int) -> dict:
+        sid = self.sids[index]
+        clear = self._canonical(self._clear_path(sid),
+                                self._clear_sid(sid) if self.bands == 4 else None)
+        conds = [self._canonical(p, sid) for p in self._cond_paths(sid)]
+        if len(conds) == 1:
+            conds = conds * 3
+        if self.augment:
+            flip, rot = self._aug_params(sid)
+            clear = self._apply_aug(clear, flip, rot)
+            conds = [self._apply_aug(c, flip, rot) for c in conds]
+        def to_model(a):
+            t = torch.from_numpy(np.ascontiguousarray(a, dtype=np.float32))
+            return t * 2.0 - 1.0
+        return {
+            "gt_image": to_model(clear),
+            "cond_image": torch.cat([to_model(c) for c in conds], dim=0),
+            "path": dump_stem(sid) + ".png",
+            "sid": sid,
+        }
+
+    def _clear_sid(self, sid: str) -> str:
+        for needle, repl in self.clear_sub:
+            if needle in sid:
+                return sid.replace(needle, repl)
+        return sid
