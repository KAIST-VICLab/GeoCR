@@ -0,0 +1,156 @@
+"""DiffCR (Palette) training for a fixed number of optimizer steps; writes final_Network.pth."""
+from __future__ import annotations
+
+import hashlib
+import json
+import time
+from pathlib import Path
+
+import torch
+import tqdm
+
+from models.model import Palette
+
+UNSUPPORTED_BUDGET_KEYS = ("eval_every", "patience", "dev_eval_ema")
+
+
+def keyed_noise(sids, shape, dtype, device) -> torch.Tensor:
+    outs = []
+    for sid in sids:
+        h = hashlib.blake2b(str(sid).encode(), digest_size=8).digest()
+        g = torch.Generator().manual_seed(int.from_bytes(h, "big") % (2 ** 63))
+        outs.append(torch.randn(shape, generator=g, dtype=torch.float32))
+    return torch.stack(outs).to(device=device, dtype=dtype)
+
+
+def bare(net):
+    return net.module if hasattr(net, "module") else net
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+class PaletteGeoCR(Palette):
+
+    def __init__(self, budget=None, **kwargs):
+        super().__init__(**kwargs)
+        if not budget:
+            raise SystemExit("PaletteGeoCR requires a `budget` block in model.which_model.args")
+        self.b = dict(budget)
+        stale = [k for k in UNSUPPORTED_BUDGET_KEYS if k in self.b]
+        if stale:
+            raise SystemExit(
+                f"budget carries unsupported key(s) {stale}; expected corpus/bands/steps/"
+                "global_batch/ckpt_selection/weights")
+        sel = str(self.b.get("ckpt_selection", "final"))
+        if sel != "final":
+            raise SystemExit(
+                f"budget.ckpt_selection = {sel!r}; only 'final' is supported")
+        self.weights = str(self.b.get("weights", "raw"))
+        if self.weights not in ("raw", "ema"):
+            raise SystemExit(f"budget.weights = {self.weights!r}; expected "
+                             "'raw' (DiffCR's own default) or 'ema'")
+        if self.weights == "ema" and self.ema_scheduler is None:
+            raise SystemExit("budget.weights = 'ema' but the config has no "
+                             "model.which_model.args.ema_scheduler")
+        self.logger.info(
+            "training split = "
+            f"{getattr(self.phase_loader.dataset, 'split', '?')}; "
+            f"checkpoint = final at step {int(self.b['steps'])}; weights = {self.weights}")
+
+    def _save_rolling(self, step: int) -> None:
+        out = Path(self.opt["path"]["checkpoint"])
+        out.mkdir(parents=True, exist_ok=True)
+        tmp = out / "rolling_ckpt.pth.tmp"
+        torch.save({"step": step, "epoch": self.epoch, "iter": self.iter,
+                    "netG": bare(self.netG).state_dict(),
+                    "netG_EMA": (bare(self.netG_EMA).state_dict()
+                                 if self.netG_EMA is not None else None),
+                    "optG": self.optG.state_dict()}, tmp)
+        tmp.replace(out / "rolling_ckpt.pth")
+        self.logger.info(f"[ckpt] rolling_ckpt.pth @ step {step}")
+
+    def _save_final(self, step: int) -> None:
+        net = bare(self.netG_EMA if self.weights == "ema" else self.netG)
+        sd = {k: v.detach().cpu() for k, v in net.state_dict().items()
+              if k.startswith("denoise_fn.")}
+        out = Path(self.opt["path"]["checkpoint"])
+        out.mkdir(parents=True, exist_ok=True)
+        torch.save(sd, out / "final_Network.pth")
+        (out / "final_meta.json").write_text(json.dumps(
+            {"ckpt_selection": "final",
+             "step": step, "steps_ceiling": int(self.b["steps"]),
+             "weights": self.weights, "tensors": len(sd)},
+            indent=2) + "\n")
+        self.logger.info(f"[ckpt] final_Network.pth: {len(sd)} tensors, "
+                         f"{self.weights} weights, step {step}")
+
+    def train(self):
+        S = int(self.b["steps"])
+        step, t0 = 0, time.time()
+        self.netG.train()
+        while step < S:
+            self.epoch += 1
+            self.train_metrics.reset()
+            for d in tqdm.tqdm(self.phase_loader, desc=f"epoch {self.epoch}"):
+                if step >= S:
+                    break
+                self.set_input(d)
+                self.optG.zero_grad()
+                loss = self.netG(self.gt_image, self.cond_image, mask=self.mask)
+                loss.backward()
+                self.optG.step()
+                step += 1
+                self.iter += self.batch_size
+                self.train_metrics.update(self.loss_fn.__name__, loss.item())
+                if self.ema_scheduler is not None and \
+                        self.iter > self.ema_scheduler["ema_start"] and \
+                        self.iter % self.ema_scheduler["ema_iter"] == 0:
+                    self.EMA.update_model_average(self.netG_EMA, self.netG)
+                ce = int(self.b.get("ckpt_every", 0))
+                if ce > 0 and step % ce == 0 and step < S:
+                    self._save_rolling(step)
+                if step % max(int(self.opt["train"]["log_iter"]), 1) == 0:
+                    self.writer.set_iter(self.epoch, step, phase="train")
+                    for k, v in self.train_metrics.result().items():
+                        self.logger.info(f"step {step} {k}: {v}")
+                        self.writer.add_scalar(k, v)
+        self._save_final(step)
+        self._summarise(step, time.time() - t0)
+
+    def _summarise(self, step, secs) -> None:
+        ds = self.phase_loader.dataset
+        n_train = len(ds)
+        bg = int(self.b["global_batch"])
+        split_file = Path(ds.root) / ds.splits_dir / f"{ds.split}.txt"
+        summary = {
+            "corpus": self.b["corpus"], "bands": int(self.b.get("bands", 3)),
+            "steps_used": step, "steps_ceiling": int(self.b["steps"]),
+            "ceiling_hit": step >= int(self.b["steps"]),
+            "stop_reason": "ceiling",
+            "batch_global": bg, "microbatch": bg, "grad_accum": 1,
+            "samples_seen": step * bg,
+            "epochs_used": round(step * bg / max(n_train, 1), 2),
+            "n_train": n_train,
+            "train_split": ds.split,
+            "train_split_file": str(split_file),
+            "train_split_sha256": sha256_file(split_file),
+            "lr": self.optG.param_groups[0]["lr"],
+            "seed": self.opt["seed"],
+            "ckpt_selection": "final",
+            "ckpt_weights": self.weights,
+            "dev_evaluations_consumed": 0,
+            "dev_slope_last10": None,
+            "ema_decay": (self.ema_scheduler or {}).get("ema_decay"),
+            "wall_clock_h": round(secs / 3600.0, 3),
+            "params_trainable": sum(p.numel() for p in self.netG.parameters()
+                                    if p.requires_grad),
+        }
+        p = Path(self.opt["path"]["experiments_root"]) / "train_summary.json"
+        p.write_text(json.dumps(summary, indent=2) + "\n")
+        self.logger.info(f"[summary] {json.dumps(summary)}")
