new file mode 100644
index 0000000..e860385
--- /dev/null
+++ b/dump_geocr.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python
+"""Write DiffCR predictions (DPM-Solver++, per-sample keyed noise) as CHW .npy files plus a manifest."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+import time
+from collections import OrderedDict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from core.praser import apply_overrides
+from data.geocr_dataset import GeoCRSplitDataset, dump_stem
+from models.geocr_model import keyed_noise
+from models.network_x0_dpm_solver import Network
+
+
+def load_config(path: str, overrides) -> dict:
+    txt = "".join(l.split("//")[0] + "\n" for l in open(path))
+    return apply_overrides(json.loads(txt, object_pairs_hook=OrderedDict), overrides)
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def build_net(opt: dict, device) -> Network:
+    net_opt = opt["model"]["which_networks"][0]["args"]
+    net = Network(unet=dict(net_opt["unet"]),
+                  beta_schedule=net_opt["beta_schedule"],
+                  module_name=net_opt["module_name"])
+    net.set_new_noise_schedule(device=device, phase="test")
+    return net.to(device).eval()
+
+
+def load_ckpt(net: Network, ckpt: Path) -> dict:
+    sd = torch.load(ckpt, map_location="cpu", weights_only=True)
+    sub = {k[len("denoise_fn."):]: v for k, v in sd.items()
+           if k.startswith("denoise_fn.")}
+    if not sub:
+        raise SystemExit(f"{ckpt}: no denoise_fn.* tensors; not a DiffCR "
+                         f"checkpoint (found e.g. {list(sd)[:3]})")
+    net.denoise_fn.load_state_dict(sub, strict=True)
+    return {"tensors_loaded": len(sub),
+            "keys_ignored": sorted(k for k in sd if not k.startswith("denoise_fn."))}
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-c", "--config", required=True)
+    ap.add_argument("-o", "--override", action="append", default=[])
+    ap.add_argument("--ckpt", default=None,
+                    help="…/final_Network.pth or pretrained/diffcr_new.pth")
+    ap.add_argument("--baseline", choices=("copy",), default=None,
+                    help="write the cloudy input as the prediction (no model)")
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--run-id", required=True, help="YYYYMMDD_<sha>_seed<N>")
+    ap.add_argument("--method", default=None, help="dump dir name; default from config")
+    ap.add_argument("--batch-size", type=int, default=16)
+    ap.add_argument("--noise", choices=("keyed", "global"), default="keyed")
+    ap.add_argument("--noise-seed", type=int, default=0, help="--noise global only")
+    ap.add_argument("--dump-root", default=None)
+    ap.add_argument("--train-summary", default=None,
+                    help="train_summary.json from the run; copied into the manifest")
+    ap.add_argument("--limit", type=int, default=0, help="predict only the first N ids (testing)")
+    ap.add_argument("--dry-run", action="store_true")
+    a = ap.parse_args()
+
+    opt = load_config(a.config, a.override)
+    g = opt["geocr"]
+    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+    ds_args = dict(opt["datasets"][a.split]["which_dataset"]["args"])
+    ds_args.update(split=a.split, augment=False)
+    ds = GeoCRSplitDataset(**ds_args)
+    if a.limit:
+        ds.sids = ds.sids[:a.limit]
+    bands = int(ds_args.get("bands", 3))
+    out_ch = 4 if (g["corpus"] == "sen2mtc_new" and bands == 3) else bands
+
+    root = Path(a.dump_root or opt["path"]["dump_root"])
+    method = a.method or g["method"]
+    run = root / g["corpus"] / a.split / method / a.run_id
+    print(f"corpus={g['corpus']} split={a.split} n={len(ds)} bands={bands} "
+          f"-> {out_ch}ch  dump={run}")
+    if a.dry_run:
+        print("[dry-run] would write "
+              f"{len(ds)} .npy ({len(ds) * out_ch * ds.resolution ** 2 * 4 / 1e6:.1f} MB)"
+              " + manifest.json")
+        return 0
+
+    if a.baseline:
+        net, ck = None, {"tensors_loaded": 0, "keys_ignored": []}
+    else:
+        if not a.ckpt:
+            raise SystemExit("--ckpt is required unless --baseline is given")
+        net = build_net(opt, dev)
+        ck = load_ckpt(net, Path(a.ckpt))
+        print(f"loaded {ck['tensors_loaded']} tensors strict=True from {a.ckpt}; "
+              f"ignored non-denoise_fn keys: {ck['keys_ignored'] or 'none'}")
+
+    (run / "preds").mkdir(parents=True, exist_ok=True)
+    loader = torch.utils.data.DataLoader(ds, batch_size=a.batch_size, shuffle=False,
+                                         num_workers=4, drop_last=False)
+    if a.noise == "global":
+        torch.manual_seed(a.noise_seed)
+    t0, written = time.time(), []
+    with torch.no_grad():
+        for d in loader:
+            cond, gt = d["cond_image"].to(dev), d["gt_image"].to(dev)
+            if a.baseline == "copy":
+                out = cond[:, :gt.shape[1]]
+            else:
+                y_t = (keyed_noise(d["sid"], gt.shape[1:], gt.dtype, dev)
+                       if a.noise == "keyed" else torch.randn_like(gt))
+                out, _ = net.restoration(cond, y_t=y_t, y_0=gt,
+                                         sample_num=opt["model"]["which_model"]["args"]["sample_num"])
+            canon = ((out.float() + 1.0) / 2.0).cpu().numpy()
+            for i, sid in enumerate(d["sid"]):
+                arr = canon[i].astype(np.float32)
+                if out_ch > arr.shape[0]:
+                    pad = np.full((out_ch - arr.shape[0], *arr.shape[1:]),
+                                  np.nan, dtype=np.float32)
+                    arr = np.concatenate([arr, pad], axis=0)
+                stem = dump_stem(sid)
+                np.save(run / "preds" / f"{stem}.npy", arr)
+                written.append(stem)
+            print(f"  {len(written)}/{len(ds)}", end="\r", flush=True)
+
+    expect = [dump_stem(s) for s in ds.sids]
+    if sorted(written) != sorted(expect):
+        raise SystemExit(f"{run}: wrote {len(written)} keys but the split has "
+                         f"{len(expect)}; refusing to write a manifest")
+    if len(set(written)) != len(written):
+        raise SystemExit(f"{run}: duplicate stems -- ids collide after '/'->'__'")
+
+    split_file = Path(ds.root) / ds.splits_dir / f"{a.split}.txt"
+    man = {
+        "corpus": g["corpus"], "split": a.split,
+        "split_list": str(split_file), "split_list_sha256": sha256_file(split_file),
+        "n_items": len(expect),
+        "resolution": [ds.resolution, ds.resolution],
+        "native_resolution": g.get("native_resolution"),
+        "resample": g.get("resample"), "crop": "none",
+        "bands": g["bands"], "bands_predicted": g["bands"][:bands],
+        "domain": g["domain"], "dtype": "float32",
+        "processing_level": g["processing_level"],
+        "method": method, "method_variant": Path(a.config).name,
+        "code_rev": git_rev(), "code_patches": g.get("code_patches", []),
+        "ckpt": str(a.ckpt) if a.ckpt else f"baseline:{a.baseline}",
+        "ckpt_sha256": sha256_file(Path(a.ckpt)) if a.ckpt else None,
+        "ckpt_tensors_loaded": ck["tensors_loaded"],
+        "ckpt_selection": g.get("ckpt_selection"),
+        "train_split_sha256": (
+            sha256_file(Path(ds.root) / ds.splits_dir / f"{g['train_split']}.txt")
+            if g.get("train_split") else
+            f"released:{sha256_file(Path(a.ckpt))[:16]}" if a.ckpt
+            else "released:unknown"),
+        "seed": opt["seed"],
+        "sampler": ({"type": f"baseline:{a.baseline}", "nfe": 0}
+                    if a.baseline else
+                    {"type": "dpmsolver++", "nfe": 21, "steps": 20, "order": 2,
+                     "correcting_x0_fn": "dynamic_thresholding",
+                     "noise": a.noise, "noise_seed":
+                         (a.noise_seed if a.noise == "global" else "blake2b(sid)")}),
+        "frames_used": ds.k, "frame_rule": g["frame_rule"],
+        "sar_used": False, "sar_fill": "n/a",
+        "surgery": g.get("surgery"),
+        "dump_seconds": round(time.time() - t0, 1),
+        "gpu": torch.cuda.get_device_name(0) if torch.cuda.is_available() else "cpu",
+        "limit_applied": a.limit or None,
+    }
+    if a.train_summary and Path(a.train_summary).is_file():
+        ts = json.loads(Path(a.train_summary).read_text())
+        ts.pop("dev_history", None)
+        declared, actual = g.get("ckpt_selection"), ts.get("ckpt_selection")
+        if declared and actual != declared:
+            raise SystemExit(
+                f"{a.train_summary}: ckpt_selection={actual!r}, but "
+                f"{Path(a.config).name} declares {declared!r}; refusing to write a manifest.")
+        man.update({k: v for k, v in ts.items() if k not in ("corpus", "bands")})
+    elif not a.limit:
+        man["training"] = ("none (copy baseline)" if a.baseline else
+                          "none (released checkpoint / inference-only row)")
+    (run / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"\nwrote {len(expect)} preds + manifest.json in "
+          f"{man['dump_seconds']}s -> {run}")
+    return 0
+
+
+def git_rev() -> str:
+    try:
+        return subprocess.check_output(["git", "rev-parse", "--short", "HEAD"],
+                                       cwd=Path(__file__).resolve().parent,
+                                       text=True).strip()
+    except Exception:
+        return "unknown"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
