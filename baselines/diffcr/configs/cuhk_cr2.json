{
    "name": "diffcr_cuhk_cr2",
    "gpu_ids": [
        0
    ],
    "seed": 0,
    "finetune_norm": false,
    "path": {
        "base_dir": "${OUT}/runs/cuhk_cr2",
        "code": "code",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null,
        "dump_root": "${OUT}/dumps"
    },
    "geocr": {
        "corpus": "cuhk_cr2",
        "method": "diffcr",
        "surgery": null,
        "processing_level": "display8",
        "bands": [
            "R",
            "G",
            "B"
        ],
        "domain": "unit_float",
        "native_resolution": [
            512,
            512
        ],
        "resample": {
            "op": "PIL.BICUBIC",
            "where": "loader (geocr.data.benchmarks._resize_u8)",
            "stage": "pre-inference"
        },
        "frame_rule": "triplicate(K=1)",
        "train_split": "trainval",
        "ckpt_selection": "final",
        "weights": "raw",
        "n_train": 448
    },
    "datasets": {
        "train": {
            "which_dataset": {
                "name": [
                    "data.geocr_dataset",
                    "GeoCRSplitDataset"
                ],
                "args": {
                    "corpus": "cuhk_cr2",
                    "root": "${CR_DATASETS}/C-CUHK/CUHK-CR2",
                    "split": "trainval",
                    "splits_dir": "splits",
                    "resolution": 256,
                    "bands": 3,
                    "augment": true,
                    "limit": 0
                }
            },
            "dataloader": {
                "args": {
                    "batch_size": 8,
                    "num_workers": 8,
                    "shuffle": true,
                    "pin_memory": true,
                    "drop_last": true
                },
                "val_args": {
                    "batch_size": 16,
                    "num_workers": 4,
                    "shuffle": false,
                    "pin_memory": true,
                    "drop_last": false
                }
            }
        },
        "val": {
            "which_dataset": {
                "name": [
                    "data.geocr_dataset",
                    "GeoCRSplitDataset"
                ],
                "args": {
                    "corpus": "cuhk_cr2",
                    "root": "${CR_DATASETS}/C-CUHK/CUHK-CR2",
                    "split": "val",
                    "splits_dir": "splits",
                    "resolution": 256,
                    "bands": 3,
                    "augment": false,
                    "limit": 0
                }
            }
        },
        "test": {
            "which_dataset": {
                "name": [
                    "data.geocr_dataset",
                    "GeoCRSplitDataset"
                ],
                "args": {
                    "corpus": "cuhk_cr2",
                    "root": "${CR_DATASETS}/C-CUHK/CUHK-CR2",
                    "split": "test",
                    "splits_dir": "splits",
                    "resolution": 256,
                    "bands": 3,
                    "augment": false,
                    "limit": 0
                }
            },
            "dataloader": {
                "args": {
                    "batch_size": 16,
                    "num_workers": 4,
                    "shuffle": false,
                    "pin_memory": true,
                    "drop_last": false
                }
            }
        }
    },
    "model": {
        "which_model": {
            "name": [
                "models.geocr_model",
                "PaletteGeoCR"
            ],
            "args": {
                "sample_num": 8,
                "task": "decloud",
                "ema_scheduler": {
                    "ema_start": 1,
                    "ema_iter": 1,
                    "ema_decay": 0.9999
                },
                "optimizers": [
                    {
                        "lr": 5e-05,
                        "weight_decay": 0
                    }
                ],
                "budget": {
                    "corpus": "cuhk_cr2",
                    "bands": 3,
                    "steps": 168000,
                    "ckpt_every": 10000,
                    "global_batch": 8,
                    "ckpt_selection": "final",
                    "weights": "raw"
                }
            }
        },
        "which_networks": [
            {
                "name": [
                    "models.network_x0_dpm_solver",
                    "Network"
                ],
                "args": {
                    "init_type": "kaiming",
                    "module_name": "ours_double_encoder_splitcaCond_splitcaUnet",
                    "unet": {
                        "img_channel": 3,
                        "width": 64,
                        "middle_blk_num": 1,
                        "enc_blk_nums": [
                            1,
                            1,
                            1,
                            1
                        ],
                        "dec_blk_nums": [
                            1,
                            1,
                            1,
                            1
                        ]
                    },
                    "beta_schedule": {
                        "train": {
                            "schedule": "sigmoid",
                            "n_timestep": 2000,
                            "linear_start": 1e-06,
                            "linear_end": 0.01
                        },
                        "test": {
                            "schedule": "sigmoid",
                            "n_timestep": 1000,
                            "linear_start": 0.0001,
                            "linear_end": 0.09
                        }
                    }
                }
            }
        ],
        "which_losses": [
            "mse_loss"
        ],
        "which_metrics": [
            "mae"
        ]
    },
    "train": {
        "n_epoch": 714,
        "n_iter": 320000,
        "val_epoch": 1000000,
        "save_checkpoint_epoch": 1000000,
        "log_iter": 100,
        "tensorboard": true
    },
    "debug": {
        "val_epoch": 1,
        "save_checkpoint_epoch": 1,
        "log_iter": 10,
        "debug_split": 32
    }
}
