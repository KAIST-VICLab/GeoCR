diff --git a/pixel/attrdict.py b/pixel/attrdict.py
new file mode 100644
index 0000000..bd6b1a7
--- /dev/null
+++ b/pixel/attrdict.py
@@ -0,0 +1,23 @@
+"""Minimal stand-in for the `attrdict` package, which does not import on Python >= 3.10."""
+
+
+class AttrMap(dict):
+    def __init__(self, mapping=None, **kw):
+        super().__init__()
+        for k, v in dict(mapping or {}, **kw).items():
+            self[k] = AttrMap(v) if isinstance(v, dict) else v
+
+    def __getattr__(self, name):
+        try:
+            return self[name]
+        except KeyError:
+            raise AttributeError(name) from None
+
+    def __setattr__(self, name, value):
+        self[name] = AttrMap(value) if isinstance(value, dict) else value
+
+    def __delattr__(self, name):
+        try:
+            del self[name]
+        except KeyError:
+            raise AttributeError(name) from None
diff --git a/pixel/dump_geocr.py b/pixel/dump_geocr.py
new file mode 100644
index 0000000..1a32327
--- /dev/null
+++ b/pixel/dump_geocr.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python
+"""Write IDF-CR pixel-stage predictions as float32 CHW .npy files plus a manifest."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+
+HERE = Path(__file__).resolve().parent
+if str(HERE) not in sys.path:
+    sys.path.insert(0, str(HERE))
+
+import geocr_data as G
+import geocr_eval as E
+from attrdict import AttrMap
+from train_geocr import build_generator, pick_device, seed_all
+
+METHOD = "idfcr-pixel"
+
+
+def load_ckpt(gen, ckpt: Path) -> None:
+    state = torch.load(ckpt, map_location="cpu", weights_only=True)
+    if all(k.startswith("module.") for k in state):
+        state = {k[len("module."):]: v for k, v in state.items()}
+    gen.load_state_dict(state)
+
+
+def canonical(cfg: dict, out, batch_index: int) -> np.ndarray:
+    fam = cfg["family"]
+    if fam == "display8":
+        return out[batch_index].cpu().numpy()
+    if fam == "sen2mtc":
+        rgb = out[batch_index].cpu().numpy()
+        pad = np.zeros((1, *rgb.shape[-2:]), dtype=rgb.dtype)
+        return np.concatenate([rgb, pad], axis=0)
+    if fam == "whus2":
+        o10, o20, o60 = out
+        return G.fuse13_arrays(o10[batch_index].cpu().numpy(),
+                               o20[batch_index].cpu().numpy(),
+                               o60[batch_index].cpu().numpy())
+    raise SystemExit(f"unknown family {fam!r}")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--ckpt", required=True)
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--ids-file", default=None,
+                    help="predict a subset of the split (one id per line)")
+    ap.add_argument("--dumps-root", default=None)
+    ap.add_argument("--run-id", default=None)
+    ap.add_argument("--dtype", default=None, choices=["float32", "float16"],
+                    help="default: float16 for 13-band splits of >=5,000 items, else float32")
+    ap.add_argument("--batch", type=int, default=None)
+    ap.add_argument("--gpu", type=int, default=None,
+                    help="GPU index (required unless --cpu)")
+    ap.add_argument("--cpu", action="store_true")
+    ap.add_argument("--dry-run", action="store_true",
+                    help="size the output and validate the key set, write nothing")
+    args = ap.parse_args()
+
+    with open(args.config, encoding="utf-8") as f:
+        config = AttrMap(yaml.safe_load(f))
+    cfg = G.corpus_cfg(config.corpus, config)
+    ckpt = Path(args.ckpt)
+
+    device = pick_device(config, args)
+    seed_all(int(config.manualSeed))
+
+    src = config.get("source", "native")
+    ds = G.build_dataset(cfg, args.split, src, config.get("export_root"),
+                         with_target=False)
+    if args.ids_file:
+        ids = [s for s in (l.split("#", 1)[0].strip()
+                           for l in Path(args.ids_file).read_text().splitlines()) if s]
+        missing = set(ids) - set(ds.ids)
+        if missing:
+            raise SystemExit(f"--ids-file has {len(missing)} ids not in the "
+                             f"{args.split} split, first: {sorted(missing)[:3]}")
+        ds.ids = ids
+    keys = [G.sid_flat(s) for s in ds.ids]
+    stems = [Path(k).stem for k in keys]
+    if len(set(stems)) != len(stems):
+        raise SystemExit("sid_flat collision -- refusing to write a dump whose "
+                         "key set cannot equal the split list")
+
+    nb = len(cfg["bands"])
+    res = int(cfg["resolution"][0])
+    dtype = args.dtype or ("float16" if (nb == 13 and len(ds.ids) >= 5000)
+                           else "float32")
+    nbytes = len(ds.ids) * nb * res * res * (2 if dtype == "float16" else 4)
+
+    run_path = ckpt.parent / "run.json"
+    run = {}
+    if run_path.is_file():
+        import json
+        run = json.loads(run_path.read_text())
+    run.setdefault("ckpt_selection", str(config.get("ckpt_selection",
+                                                    "best_on_dev(raw)")))
+    run.setdefault("train_split", str(config.get("train_split", "train")))
+    if run["ckpt_selection"] == "final" and ckpt.name != "last.pth":
+        raise SystemExit(
+            f"{ckpt.name}: ckpt_selection: final expects the run's last.pth")
+    cfg_sha = hashlib.sha256(Path(args.config).read_bytes()).hexdigest()[:7]
+    run_id = args.run_id or (f"{time.strftime('%Y%m%d')}_{cfg_sha}_"
+                             f"seed{run.get('seed', config.manualSeed)}")
+    dumps_root = Path(args.dumps_root or config.dumps_root)
+    method = METHOD
+    out_dir = dumps_root / cfg["dumps_key"] / args.split / method / run_id
+
+    print(f"[dump] {cfg['corpus']}/{args.split} n={len(ds.ids)} "
+          f"{nb}x{res}x{res} {dtype} -> {out_dir}")
+    print(f"[dump] {nbytes/1e9:.3f} GB in {len(ds.ids)} files "
+          f"({'DRY RUN, nothing written' if args.dry_run else 'writing'})")
+    if args.dry_run:
+        return 0
+
+    gen = build_generator(cfg["family"], device)
+    load_ckpt(gen, ckpt)
+    gen.eval()
+
+    (out_dir / "preds").mkdir(parents=True, exist_ok=True)
+    batch = int(args.batch or config.get("validation_batchsize", 8))
+    np_dtype = np.float16 if dtype == "float16" else np.float32
+    t0 = time.time()
+    written = 0
+    with torch.no_grad():
+        for lo in range(0, len(ds), batch):
+            items = [ds[i] for i in range(lo, min(lo + batch, len(ds)))]
+            sids = [it[-1] for it in items]
+            if cfg["family"] == "whus2":
+                x10 = torch.from_numpy(np.stack([it[0] for it in items])).to(device)
+                x20 = torch.from_numpy(np.stack([it[1] for it in items])).to(device)
+                x60 = torch.from_numpy(np.stack([it[2] for it in items])).to(device)
+                out = gen(x10, x20, x60)
+            else:
+                x = torch.from_numpy(np.stack([it[0] for it in items])).to(device)
+                out = gen(x)[1]
+            for b, sid in enumerate(sids):
+                arr = canonical(cfg, out, b).astype(np_dtype, copy=False)
+                if arr.shape != (nb, res, res):
+                    raise SystemExit(f"{sid}: dumped {arr.shape}, corpus declares "
+                                     f"{(nb, res, res)}")
+                np.save(out_dir / "preds" / f"{Path(G.sid_flat(sid)).stem}.npy", arr)
+                written += 1
+            if lo % (batch * 20) == 0:
+                print(f"[dump] {written}/{len(ds)}  ({time.time()-t0:.0f}s)")
+
+    have = {p.stem for p in (out_dir / "preds").glob("*.npy")}
+    if have != set(stems):
+        raise SystemExit(f"key set != split list ({len(have)} vs {len(stems)}) -- "
+                         "the rescorer would refuse this dump; refusing to "
+                         "write the manifest for it")
+
+    split_list = (Path(args.ids_file) if args.ids_file
+                  else Path(cfg["root"]) / cfg["splits_dir"] / f"{args.split}.txt")
+    extra = {
+        "run_id": run_id,
+        "dtype": dtype,
+        "split_list": str(split_list),
+        "split_list_sha256": E.sha256_file(split_list),
+        "ckpt": str(ckpt.resolve()),
+        "dump_seconds": round(time.time() - t0, 1),
+        "stage": "pixel",
+        "row_label": "IDF-CR (pixel stage)",
+        "caption_caveat": "pixel stage only; the latent refinement stage is not run",
+    }
+    if cfg["family"] == "sen2mtc":
+        extra.update({
+            "bands_predicted": ["R", "G", "B"],
+            "band_pad": {"NIR": "zeros (not predicted by this 3-channel model)"},
+        })
+    man = E.build_manifest(cfg, args.split, run, method=method,
+                           method_variant=Path(args.config).name, ckpt=ckpt,
+                           repo=HERE.parent, source=src, n_items=len(ds.ids),
+                           extra=extra)
+    E.write_json(out_dir / "manifest.json", man)
+    print(f"[dump] wrote {written} preds + manifest.json to {out_dir}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
