diff --git a/pixel/geocr_data.py b/pixel/geocr_data.py
new file mode 100644
index 0000000..372862b
--- /dev/null
+++ b/pixel/geocr_data.py
@@ -0,0 +1,216 @@
+"""Split-list datasets for the IDF-CR pixel stage."""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils import data
+
+GEOCR_ROOT = Path(os.environ.get("GEOCR_ROOT", Path(__file__).resolve().parents[2] / "GeoCR"))
+BASELINES = Path(os.environ.get("GEOCR_BASELINES", GEOCR_ROOT / "baselines" / "common"))
+for _p in (str(BASELINES), str(BASELINES / "exporters"), str(GEOCR_ROOT)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import rescore as RS
+from geocr.data.benchmarks import (
+    WHUS2CRvProvider, _read_png, _read_tif, _resize_u8,
+)
+
+U8 = 1.0 / 255.0
+
+IDFCR: dict[str, dict] = {
+    "tcloud": dict(family="display8", splits_dir="splits", dumps_key="tcloud",
+                   native=256, dev_key="tcloud_psnr"),
+    "cuhk_cr1": dict(
+        family="display8", splits_dir="splits", dumps_key="cuhk_cr",
+        native=512, dev_key="cuhkrgb_psnr",
+        override=dict(lineage="cuhk_rgb", bands=["R", "G", "B"], nir=False)),
+    "cuhk_cr2": dict(family="display8", splits_dir="splits", dumps_key="cuhk_cr2",
+                     native=512, dev_key="cuhkrgb_psnr"),
+    "sen2mtc_new": dict(family="sen2mtc", splits_dir="splits",
+                        dumps_key="sen2mtc_new", native=256, dev_key="mtc_psnr",
+                        frame=0),
+    "whus2crv": dict(family="whus2", splits_dir="splits", dumps_key="whus2crv",
+                     native=384, dev_key="psnr_all"),
+}
+
+
+def corpus_cfg(name: str, config=None) -> dict:
+    if name not in IDFCR:
+        raise SystemExit(
+            f"IDF-CR has no configuration for {name!r}; available: {sorted(IDFCR)}")
+    cfg = dict(RS.CORPORA[RS.resolve_corpus(name)])
+    extra = dict(IDFCR[name])
+    cfg.update(extra.pop("override", {}))
+    cfg.update(extra)
+    cfg["corpus"] = name
+    if config is not None:
+        if config.get("root"):
+            cfg["root"] = Path(config["root"])
+        if config.get("splits_dir"):
+            cfg["splits_dir"] = str(config["splits_dir"])
+    return cfg
+
+
+def sid_flat(sid: str) -> str:
+    return sid.replace("/", "__")
+
+
+def read_split(cfg: dict, split: str, root: Path | None = None) -> list[str]:
+    return RS.read_split(Path(root or cfg["root"]), split, cfg["splits_dir"])
+
+
+def attention_target(t: np.ndarray, x: np.ndarray, unit: float) -> np.ndarray:
+    return np.clip((t - x).sum(axis=-1) / unit, 0.0, 1.0).astype(np.float32)
+
+
+def _chw(a: np.ndarray) -> np.ndarray:
+    return np.ascontiguousarray(a.transpose(2, 0, 1), dtype=np.float32)
+
+
+class Display8Dataset(data.Dataset):
+
+    def __init__(self, cfg: dict, split: str, source: str = "native",
+                 export_root: str | None = None, with_target: bool = True):
+        self.cfg, self.split, self.source = cfg, split, source
+        self.res = int(cfg["resolution"][0])
+        self.nb = len(cfg["bands"])
+        self.with_target = with_target
+        self.root = Path(cfg["root"])
+        self.ids = read_split(cfg, split)
+        self.export = None
+        if source == "export":
+            if not export_root:
+                raise SystemExit("source: export requires export_root")
+            self.export = Path(export_root) / cfg["corpus"] / split
+            if not (self.export / "cloudy").is_dir():
+                raise SystemExit(
+                    f"{self.export}/cloudy missing -- run exporters/export_display8.py "
+                    f"--corpus {cfg['corpus']} --split {split}, or set source: native")
+        elif source != "native":
+            raise SystemExit(f"unknown source {source!r} (native|export)")
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def _clear_id(self, sid: str) -> str:
+        for needle, repl in self.cfg["clear_sub"]:
+            if needle in sid and (self.root / sid.replace(needle, repl)).is_file():
+                return sid.replace(needle, repl)
+        raise SystemExit(f"{sid}: no clear pair under {self.root}")
+
+    def _pair_u8(self, sid: str):
+        if self.source == "export":
+            k = sid_flat(sid)
+            x = _read_png(self.export / "cloudy" / k)
+            t = _read_png(self.export / "clear" / k) if self.with_target else None
+        else:
+            x = _resize_u8(_read_png(self.root / sid), self.res)
+            t = (_resize_u8(_read_png(self.root / self._clear_id(sid)), self.res)
+                 if self.with_target else None)
+        return x[..., :3], (None if t is None else t[..., :3])
+
+    def __getitem__(self, i: int):
+        sid = self.ids[i]
+        x_u8, t_u8 = self._pair_u8(sid)
+        x = _chw(x_u8.astype(np.float32) / 255.0)
+        if not self.with_target:
+            return x, sid
+        M = attention_target(t_u8.astype(np.float32), x_u8.astype(np.float32), 1.0)
+        t = _chw(t_u8.astype(np.float32) / 255.0)
+        return x, t, M, sid
+
+
+class Sen2MTCFrameDataset(data.Dataset):
+
+    def __init__(self, cfg: dict, split: str, frame: int = 0,
+                 with_target: bool = True):
+        self.cfg, self.frame, self.with_target = cfg, int(frame), with_target
+        self.root = Path(cfg["root"])
+        self.ids = read_split(cfg, split)
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def _frame_path(self, sid: str) -> Path:
+        target = self.root / sid
+        return target.parent.parent / "cloud" / f"{target.stem}_{self.frame}.tif"
+
+    def __getitem__(self, i: int):
+        sid = self.ids[i]
+        p = self._frame_path(sid)
+        if not p.is_file():
+            raise FileNotFoundError(f"{p}: expected cloud frame {self.frame}")
+        x4 = _read_tif(p).astype(np.float32) / 10000.0
+        x = np.ascontiguousarray(x4[:3])
+        if not self.with_target:
+            return x, sid
+        t4 = _read_tif(self.root / sid).astype(np.float32) / 10000.0
+        t = np.ascontiguousarray(t4[:3])
+        M = attention_target(t.transpose(1, 2, 0), x.transpose(1, 2, 0), U8)
+        return x, t, M, sid
+
+
+def whus2_paths(root: Path, sid: str) -> dict[str, Path]:
+    out = {}
+    for role in ("clear", "cloud"):
+        for res in ("10m", "20m", "60m"):
+            rel = sid.replace("clearDNclips", f"{role}DNclips").replace("/10m/", f"/{res}/")
+            out[f"{role}{res[:-1]}"] = Path(root) / rel
+    return out
+
+
+def fuse13_arrays(a10: np.ndarray, a20: np.ndarray, a60: np.ndarray) -> np.ndarray:
+    W = WHUS2CRvProvider
+    src = {"10m": a10, "20m": a20, "60m": a60}
+    h, w = a10.shape[-2:]
+    out = np.zeros((13, h, w), dtype=a10.dtype)
+    for res, dst in W.BAND_POS.items():
+        arr = src[res]
+        if arr.shape[0] != len(dst):
+            raise ValueError(f"{res}: expected {len(dst)} bands, got {arr.shape[0]}")
+        f = W.UPSAMPLE[res]
+        if f > 1:
+            arr = np.repeat(np.repeat(arr, f, axis=-2), f, axis=-1)
+        if arr.shape[-2:] != (h, w):
+            raise ValueError(f"{res}: upsampled to {arr.shape[-2:]}, expected {(h, w)}")
+        out[list(dst)] = arr
+    return out
+
+
+class WHUS2Dataset(data.Dataset):
+
+    def __init__(self, cfg: dict, split: str, with_target: bool = True):
+        self.cfg, self.with_target = cfg, with_target
+        self.root = Path(cfg["root"])
+        self.ids = read_split(cfg, split)
+
+    def __len__(self) -> int:
+        return len(self.ids)
+
+    def __getitem__(self, i: int):
+        sid = self.ids[i]
+        p = whus2_paths(self.root, sid)
+        x = [_read_tif(p[f"cloud{r}"]).astype(np.float32) / 10000.0
+             for r in ("10", "20", "60")]
+        if not self.with_target:
+            return x[0], x[1], x[2], sid
+        t = [_read_tif(p[f"clear{r}"]).astype(np.float32) / 10000.0
+             for r in ("10", "20", "60")]
+        return x[0], x[1], x[2], t[0], t[1], t[2], sid
+
+
+def build_dataset(cfg: dict, split: str, source: str = "native",
+                  export_root: str | None = None, with_target: bool = True):
+    fam = cfg["family"]
+    if fam == "display8":
+        return Display8Dataset(cfg, split, source, export_root, with_target)
+    if fam == "sen2mtc":
+        return Sen2MTCFrameDataset(cfg, split, cfg.get("frame", 0), with_target)
+    if fam == "whus2":
+        return WHUS2Dataset(cfg, split, with_target)
+    raise SystemExit(f"unknown family {fam!r}")
