+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import torch
+
+import geocr_data as G
+from geocr_data import RS
+
+
+def dev_indices(n: int, cap: int) -> list[int]:
+    if cap <= 0 or cap >= n:
+        return list(range(n))
+    step = math.ceil(n / cap)
+    return list(range(0, n, step))[:cap]
+
+
+def metrics_mean(preds: list[torch.Tensor], gts: list[torch.Tensor],
+                 cfg: dict) -> dict[str, float]:
+    acc: dict[str, list[float]] = {}
+    for p, g in zip(preds, gts):
+        for k, v in RS.metrics_one(p, g, cfg, None).items():
+            acc.setdefault(k, []).append(float(v))
+    return {k: float(np.mean(v)) for k, v in acc.items()}
+
+
+def slope_last10(history: list[tuple[int, float]]) -> float | None:
+    if len(history) < 2:
+        return None
+    last_step, last_val = history[-1]
+    cut = 0.9 * last_step
+    ref = min(history, key=lambda h: abs(h[0] - cut))
+    return float(last_val - ref[1])
+
+
+def loss_slope_last10(losses: list[float]) -> float | None:
+    n = len(losses)
+    if n < 20:
+        return None
+    w = max(1, n // 10)
+    late = sum(losses[-w:]) / w
+    prev = sum(losses[-2 * w:-w]) / w
+    return float(late - prev)
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(1 << 20), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def code_rev(repo: Path) -> str:
+    try:
+        return subprocess.run(["git", "-C", str(repo), "rev-parse", "--short", "HEAD"],
+                              capture_output=True, text=True, timeout=20).stdout.strip() or "unknown"
+    except Exception:
+        return "unknown"
+
+
+CODE_PATCHES = [
+    "WHUS2/allnet.py sorted() at both glob levels",
+    "WHUS2/gdaldiy.py gdal -> tifffile",
+    "train_woGAN.py, train_woGAN_whus2.py DataParallel device_ids",
+    "eval.py, eval_2.py, eval_3.py compare_ssim -> structural_similarity",
+    "models/gen/SPANet.py, SPANet_whus2.py cpu device fallback",
+    "predict_2.py save the prediction, not the attention map",
+    "new: attrdict.py geocr_data.py geocr_eval.py train_geocr.py dump_geocr.py",
+]
+
+
+def build_manifest(cfg: dict, split: str, run: dict, *, method: str,
+                   method_variant: str, ckpt: Path, repo: Path,
+                   source: str, n_items: int, extra: dict | None = None) -> dict:
+    root = Path(cfg["root"])
+    split_list = root / cfg["splits_dir"] / f"{split}.txt"
+    train_split = run.get("train_split", "train")
+    train_list = root / cfg["splits_dir"] / f"{train_split}.txt"
+    native = int(cfg["native"])
+    res = int(cfg["resolution"][0])
+
+    if cfg["family"] == "display8":
+        resample = ({"op": "none", "where": "n/a", "stage": "n/a"} if native == res else
+                    {"op": "PIL.BICUBIC",
+                     "where": "exporter" if source == "export" else "loader",
+                     "stage": "pre-inference",
+                     "fn": "geocr.data.benchmarks._resize_u8"})
+    else:
+        resample = {"op": "none", "where": "n/a", "stage": "n/a"}
+
+    man = {
+        "corpus": cfg["corpus"], "split": split,
+        "split_list_sha256": sha256_file(split_list), "n_items": n_items,
+        "resolution": [res, res], "crop": "none",
+        "bands": list(cfg["bands"]), "domain": cfg["domain"],
+        "processing_level": cfg["level"],
+        "split_list": str(split_list),
+        "native_resolution": [native, native],
+        "resample": resample,
+        "method": method, "method_variant": method_variant,
+        "code_rev": code_rev(repo), "code_patches": list(CODE_PATCHES),
+        "ckpt_sha256": sha256_file(ckpt) if ckpt and Path(ckpt).is_file() else None,
+        "ckpt_selection": run.get("ckpt_selection", "best_on_dev(raw)"),
+        "ema": run.get("ema", False),
+        "train_split": train_split,
+        "train_split_sha256": sha256_file(train_list) if train_list.is_file() else None,
+        "n_train": run.get("n_train"),
+        "seed": run.get("seed"),
+        "sampler": {"type": "deterministic_feedforward", "nfe": 1},
+        "frames_used": run.get("frames_used", 1),
+        "frame_rule": run.get("frame_rule", "n/a"),
+        "sar_used": False,
+        "sar_fill": "n/a",
+        "steps_used": run.get("steps_used"), "epochs_used": run.get("epochs_used"),
+        "ceiling_hit": run.get("ceiling_hit"),
+        "dev_evaluations_consumed": run.get("dev_evaluations_consumed"),
+        "dev_slope_last10": run.get("dev_slope_last10"),
+        "dev_metric": run.get("dev_metric"), "dev_best": run.get("dev_best"),
+        "dev_subset": run.get("dev_subset"),
+        "train_loss_slope_last10": run.get("train_loss_slope_last10"),
+        "batch_global": run.get("batch_global"), "microbatch": run.get("microbatch"),
+        "grad_accum": 1, "lr": run.get("lr"),
+        "wall_clock_h": run.get("wall_clock_h"), "gpu": run.get("gpu"),
+        "params_trainable": run.get("params_trainable"),
+        "params_total": run.get("params_total"),
+    }
+    if extra:
+        man.update(extra)
+    return man
+
+
+def write_json(p: Path, payload: dict) -> None:
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n")
