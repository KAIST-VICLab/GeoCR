diff --git a/pixel/train_geocr.py b/pixel/train_geocr.py
new file mode 100644
index 0000000..8d997a3
--- /dev/null
+++ b/pixel/train_geocr.py
@@ -0,0 +1,274 @@
+#!/usr/bin/env python
+"""Train the IDF-CR pixel stage on a split list for a fixed number of optimizer steps."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from torch import nn, optim
+from torch.utils.data import DataLoader
+
+HERE = Path(__file__).resolve().parent
+if str(HERE) not in sys.path:
+    sys.path.insert(0, str(HERE))
+
+import geocr_data as G
+import geocr_eval as E
+from attrdict import AttrMap
+
+
+def pick_device(config, args) -> torch.device:
+    if getattr(args, "cpu", False):
+        os.environ["CUDA_VISIBLE_DEVICES"] = ""
+        return torch.device("cpu")
+    ids = [args.gpu] if getattr(args, "gpu", None) is not None else list(config.gpu_ids)
+    if not config.cuda:
+        return torch.device("cpu")
+    if not ids:
+        raise SystemExit("no GPU selected: pass --gpu N, or --cpu")
+    os.environ["CUDA_VISIBLE_DEVICES"] = ",".join(map(str, ids))
+    if not torch.cuda.is_available():
+        raise SystemExit(f"CUDA_VISIBLE_DEVICES={ids} but torch sees no GPU")
+    config.gpu_ids = ids
+    return torch.device("cuda:0")
+
+
+def build_generator(family: str, device: torch.device):
+    if family == "whus2":
+        from models.gen.SPANet_whus2 import Generator
+    else:
+        from models.gen.SPANet import Generator
+    gen = Generator(gpu_ids=[0])
+    gen.device = device
+    return gen.to(device)
+
+
+def seed_all(seed: int) -> None:
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+
+
+def loader(ds, batch, shuffle, threads, seed):
+    g = torch.Generator()
+    g.manual_seed(seed)
+    return DataLoader(ds, batch_size=batch, shuffle=shuffle, num_workers=threads,
+                      drop_last=shuffle, generator=g if shuffle else None,
+                      pin_memory=torch.cuda.is_available())
+
+
+@torch.no_grad()
+def evaluate(gen, ds, cfg, device, batch, threads, cap: int) -> dict[str, float]:
+    gen.eval()
+    idx = E.dev_indices(len(ds), cap)
+    sub = torch.utils.data.Subset(ds, idx)
+    dl = loader(sub, batch, False, threads, 0)
+    preds, gts = [], []
+    for batch_i in dl:
+        if cfg["family"] == "whus2":
+            x10, x20, x60, t10, t20, t60 = [b.to(device) for b in batch_i[:6]]
+            o10, o20, o60 = gen(x10, x20, x60)
+            for b in range(x10.shape[0]):
+                preds.append(torch.from_numpy(G.fuse13_arrays(
+                    o10[b].cpu().numpy(), o20[b].cpu().numpy(), o60[b].cpu().numpy())))
+                gts.append(torch.from_numpy(G.fuse13_arrays(
+                    t10[b].cpu().numpy(), t20[b].cpu().numpy(), t60[b].cpu().numpy())))
+        else:
+            x, t = batch_i[0].to(device), batch_i[1]
+            _, out = gen(x)
+            out = out.cpu()
+            for b in range(x.shape[0]):
+                preds.append(out[b])
+                gts.append(t[b])
+    gen.train()
+    return E.metrics_mean(preds, gts, cfg)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--lr", type=float, default=None,
+                    help="override config.lr")
+    ap.add_argument("--seed", type=int, default=None, help="override config.manualSeed")
+    ap.add_argument("--out", default=None, help="override config.out_dir")
+    ap.add_argument("--gpu", type=int, default=None,
+                    help="GPU index (required unless --cpu)")
+    ap.add_argument("--cpu", action="store_true")
+    ap.add_argument("--max-steps", type=int, default=None,
+                    help="override config.max_steps (short test runs)")
+    args = ap.parse_args()
+
+    with open(args.config, encoding="utf-8") as f:
+        config = AttrMap(yaml.safe_load(f))
+    if args.lr is not None:
+        config.lr = args.lr
+    if args.seed is not None:
+        config.manualSeed = args.seed
+    if args.out is not None:
+        config.out_dir = args.out
+    if args.max_steps is not None:
+        config.max_steps = args.max_steps
+        config.short_run = True
+
+    sel = str(config.get("ckpt_selection", "best_on_dev(raw)"))
+    final_only = sel == "final"
+    train_split = str(config.get("train_split", "train"))
+    if final_only and train_split == "train":
+        raise SystemExit("ckpt_selection: final expects train_split: trainval")
+
+    cfg = G.corpus_cfg(config.corpus, config)
+    device = pick_device(config, args)
+    seed_all(int(config.manualSeed))
+    torch.backends.cudnn.benchmark = True
+
+    out_dir = Path(config.out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    (out_dir / "config_used.yml").write_text(yaml.safe_dump(dict(config), sort_keys=False))
+
+    src = config.get("source", "native")
+    train_ds = G.build_dataset(cfg, train_split, src, config.get("export_root"))
+    if set(G.read_split(cfg, train_split)) & set(G.read_split(cfg, "test")):
+        raise SystemExit(f"{train_split} and test overlap -- refusing to train")
+    if final_only:
+        val_ds = None
+    else:
+        val_ds = G.build_dataset(cfg, "val", src, config.get("export_root"))
+        if set(G.read_split(cfg, "val")) & set(G.read_split(cfg, "test")):
+            raise SystemExit("val and test overlap -- refusing to train")
+    print(f"[train] corpus={cfg['corpus']} family={cfg['family']} "
+          f"split={train_split} n_train={len(train_ds)} "
+          f"n_val={'none' if final_only else len(val_ds)} "
+          f"ckpt_selection={sel} device={device}")
+
+    gen = build_generator(cfg["family"], device)
+    n_par = sum(p.numel() for p in gen.parameters())
+    opt = optim.Adam(gen.parameters(), lr=config.lr,
+                     betas=(config.beta1, 0.999), weight_decay=0.00001)
+    l1, mse = nn.L1Loss().to(device), nn.MSELoss().to(device)
+
+    max_steps = int(config.max_steps)
+    if final_only:
+        eval_every = int(config.get("ckpt_every", config.get("eval_every", max_steps)))
+        patience, dev_cap = None, 0
+    else:
+        eval_every = int(config.eval_every)
+        patience = int(config.patience_evals)
+        dev_cap = int(config.get("dev_subset", 0))
+    dev_key = cfg["dev_key"]
+
+    dl = loader(train_ds, int(config.batchsize), True, int(config.threads),
+                int(config.manualSeed))
+    step, best, best_step, since_best, n_nonfinite = 0, -float("inf"), 0, 0, 0
+    history: list[tuple[int, float]] = []
+    losses: list[float] = []
+    t0 = time.time()
+    stop = False
+
+    while not stop:
+        for batch in dl:
+            if cfg["family"] == "whus2":
+                x10, x20, x60, t10, t20, t60 = [b.to(device, non_blocking=True)
+                                                for b in batch[:6]]
+                o10, o20, o60 = gen(x10, x20, x60)
+                loss = (l1(o10, t10) + l1(o20, t20) + l1(o60, t60)) * config.lamb
+            else:
+                x, t, M = [b.to(device, non_blocking=True) for b in batch[:3]]
+                att, out = gen(x)
+                loss = l1(out, t) * config.lamb + mse(att[:, 0, :, :], M)
+
+            opt.zero_grad()
+            loss.backward()
+            opt.step()
+            step += 1
+            losses.append(float(loss.detach()))
+            if not torch.isfinite(loss):
+                n_nonfinite += 1
+                print(f"[train] WARNING non-finite loss at step {step} "
+                      f"(upstream has no guard; counted, not skipped)")
+
+            if step % 50 == 0:
+                print(f"[train] step {step}/{max_steps} loss {loss.item():.4f} "
+                      f"({(time.time()-t0)/step:.3f} s/step)")
+
+            if step % eval_every == 0 or step >= max_steps:
+                if final_only:
+                    torch.save(gen.state_dict(), out_dir / "last.pth")
+                else:
+                    m = evaluate(gen, val_ds, cfg, device, int(config.validation_batchsize),
+                                 int(config.threads), dev_cap)
+                    v = m[dev_key]
+                    history.append((step, v))
+                    improved = v > best
+                    print(f"[dev] step {step}  {dev_key}={v:.4f}"
+                          f"{'  *best*' if improved else ''}  "
+                          + "  ".join(f"{k}={x:.4f}" for k, x in m.items() if k != dev_key))
+                    if improved:
+                        best, best_step, since_best = v, step, 0
+                        torch.save(gen.state_dict(), out_dir / "best.pth")
+                    else:
+                        since_best += 1
+                    torch.save(gen.state_dict(), out_dir / "last.pth")
+                    if since_best >= patience:
+                        print(f"[train] early stop: {patience} evals without improvement")
+                        stop = True
+            if step >= max_steps or stop:
+                stop = True
+                break
+
+    wall = (time.time() - t0) / 3600.0
+    run = {
+        "corpus": cfg["corpus"], "config": str(Path(args.config).resolve()),
+        "short_run": bool(config.get("short_run", False)),
+        "seed": int(config.manualSeed), "lr": float(config.lr),
+        "batch_global": int(config.batchsize), "microbatch": int(config.batchsize),
+        "grad_accum": 1,
+        "train_split": train_split,
+        "n_train": len(train_ds), "n_val": None if final_only else len(val_ds),
+        "steps_used": step, "max_steps": max_steps,
+        "epochs_used": round(step * int(config.batchsize) / max(len(train_ds), 1), 2),
+        "ceiling_hit": step >= max_steps,
+        "dev_metric": None if final_only else dev_key,
+        "dev_best": None if final_only else best,
+        "dev_best_step": None if final_only else best_step,
+        "dev_evaluations_consumed": len(history),
+        "dev_slope_last10": E.slope_last10(history),
+        "dev_subset": None if final_only else (dev_cap or len(val_ds)),
+        "dev_history": history,
+        "train_loss_slope_last10": E.loss_slope_last10(losses),
+        "ema": False,
+        "ckpt_selection": sel,
+        "ckpt_dumped": "last.pth" if final_only else "best.pth",
+        "frames_used": 1,
+        "frame_rule": ("frame index 0"
+                       if cfg["family"] == "sen2mtc" else "n/a"),
+        "wall_clock_h": round(wall, 3),
+        "gpu": (torch.cuda.get_device_name(0) if device.type == "cuda" else "cpu"),
+        "params_trainable": n_par, "params_total": n_par,
+        "n_nonfinite_loss": n_nonfinite,
+        "source": src,
+    }
+    E.write_json(out_dir / "run.json", run)
+    if final_only:
+        print(f"[train] done: {step} steps, {wall*60:.1f} min; checkpoint {out_dir/'last.pth'}")
+        keys = ("steps_used", "epochs_used", "ceiling_hit",
+                "ckpt_selection", "train_loss_slope_last10")
+    else:
+        print(f"[train] done: {step} steps, {wall*60:.1f} min, "
+              f"best {dev_key}={best:.4f} @ step {best_step}")
+        keys = ("steps_used", "epochs_used", "ceiling_hit",
+                "dev_best", "dev_slope_last10")
+    print(json.dumps({k: run[k] for k in keys}, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
