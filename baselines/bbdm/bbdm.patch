+#!/usr/bin/env python
+"""Write test-set predictions for geocr.eval: <out>/preds/<id>.npy (float32 CHW in [0, 1],
+unclipped) and <out>/manifest.json.
+
+    python dump.py --config <config.yaml> --ckpt <dir with last_model.pth> --out <dir>
+
+Sampling uses the EMA weights (the repository's test-time default), one image at a time with the
+global RNG seeded from (seed, id). The frozen VQGAN is restored from last_model.pth, so the vq-f4
+checkpoint named in the config is not needed here.
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from tqdm import tqdm
+
+import geocr_data as G
+import rescore as RS
+from utils import dict2namespace
+
+
+def build_net(config, ckpt: Path, device):
+    from model.BrownianBridge.LatentBrownianBridgeModel import LatentBrownianBridgeModel
+    config.model.VQGAN.params.ckpt_path = None
+    net = LatentBrownianBridgeModel(config.model)
+    states = torch.load(ckpt, map_location="cpu", weights_only=False)
+    net.load_state_dict(states["model"], strict=True)
+    with torch.no_grad():
+        for n, p in net.named_parameters():
+            if p.requires_grad:
+                p.data.copy_(states["ema"][n].to(p.dtype))
+    return net.to(device).eval()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--ckpt", required=True, help="directory holding last_model.pth")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seed", type=int, default=0)
+    a = ap.parse_args()
+
+    with open(a.config) as f:
+        config = dict2namespace(yaml.load(f, Loader=yaml.FullLoader))
+    cfg = G.corpus_cfg(config.data.dataset_config.corpus)
+    ids = G.read_split(cfg, "test")
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    ckpt = Path(a.ckpt) / "last_model.pth"
+    net = build_net(config, ckpt, device)
+
+    preds = Path(a.out) / "preds"
+    preds.mkdir(parents=True, exist_ok=True)
+    with torch.no_grad():
+        for sid in tqdm(ids):
+            cloudy = G.load_u01(cfg, "test", sid, "cloudy")
+            x_cond = (torch.from_numpy(cloudy)[None].to(device) - 0.5) * 2.0
+            torch.manual_seed(G.sample_seed(a.seed, sid))
+            sample = net.sample(x_cond, clip_denoised=bool(config.testing.clip_denoised))
+            arr = ((sample[0].detach().float().cpu() + 1.0) / 2.0).numpy()
+            np.save(preds / f"{Path(G.sid_flat(sid)).stem}.npy",
+                    np.ascontiguousarray(arr, dtype=np.float32))
+
+    man = {"corpus": cfg["corpus"], "split": "test",
+           "split_list_sha256": G.split_sha256(cfg, "test"), "n_items": len(ids),
+           "resolution": list(cfg["resolution"]), "crop": "none", "bands": list(cfg["bands"]),
+           "domain": cfg["domain"], "processing_level": cfg["level"],
+           "ckpt_selection": "final",
+           "train_split_sha256": G.split_sha256(cfg, config.data.dataset_config.train_split),
+           "method": "bbdm", "seed": a.seed, "ckpt_sha256": RS.sha256_file(ckpt)}
+    missing = [k for k in RS.IDENTITY_KEYS if k not in man]
+    if missing:
+        raise SystemExit(f"manifest lacks {missing}")
+    (Path(a.out) / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
+    print(f"{len(ids)} predictions -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
