+"""dataset_type 'geocr_split': items ((clear, id), (cloudy, id)) in [-1, 1], read by split-list id.
+Stages 'train' and 'val' read dataset_config.train_split; 'test' reads the test split."""
+from pathlib import Path
+
+import torch
+from torch.utils.data import Dataset
+
+import geocr_data as G
+from Register import Registers
+
+
+@Registers.datasets.register_with_name('geocr_split')
+class GeoCRSplitAlignedDataset(Dataset):
+    def __init__(self, dataset_config, stage='train'):
+        super().__init__()
+        if not dataset_config.to_normal or dataset_config.flip or dataset_config.image_size != 256:
+            raise SystemExit("geocr_split supports to_normal: True, flip: False, image_size: 256")
+        self.cfg = G.corpus_cfg(dataset_config.corpus)
+        self.split = dataset_config.train_split if stage in ('train', 'val') else 'test'
+        self.ids = G.read_split(self.cfg, self.split)
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, i):
+        sid = self.ids[i]
+        x_cond = (torch.from_numpy(G.load_u01(self.cfg, self.split, sid, "cloudy")) - 0.5) * 2.0
+        x = (torch.from_numpy(G.load_u01(self.cfg, self.split, sid, "clear")) - 0.5) * 2.0
+        name = Path(G.sid_flat(sid)).stem
+        return (x, name), (x_cond, name)
